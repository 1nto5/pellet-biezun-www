---
/**
 * The only layout. Every page renders through it: the head with the meta tags
 * and the JSON-LD (the company on every page, the breadcrumb trail where there
 * is one), the skip link, the header, one <main id="tresc"> and the footer.
 *
 * The Content-Security-Policy is not here but in `public/_headers`, which
 * Cloudflare Pages sends as real HTTP headers (a <meta> cannot set
 * `frame-ancestors`).
 */
import "../styles/global.css";
import "../components/ruch/ruch.css";
import { getImage } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { firma, firmaId, addressLine } from "../data/firma";
import { miejsca, DARMOWA_DOSTAWA_KM } from "../data/miejsca";
import { breadcrumbsFor } from "../data/nav";
import { przedStartem } from "../data/strona";
import { isPreview } from "../lib/env";
import { nazwaWlasna } from "../lib/miejsce";
import { href, absoluteUrl } from "../lib/url";
import ogSource from "../assets/og.jpg";
// Preloaded, so the text does not wait for the stylesheet to ask for them.
// The same files global.css declares; Polish text needs both subsets.
import fontLatin from "@fontsource-variable/league-spartan/files/league-spartan-latin-wght-normal.woff2?url";
import fontLatinExt from "@fontsource-variable/league-spartan/files/league-spartan-latin-ext-wght-normal.woff2?url";

interface Props {
  /** Left out on the home page, whose title is the company name alone. */
  title?: string;
  description?: string;
  /** Extra JSON-LD objects for this page, e.g. FAQPage. */
  jsonLd?: Record<string, unknown>[];
  /** A page that is not a page of the site, like the 404: no canonical address, never indexed. */
  noindex?: boolean;
}

const { title, description, jsonLd = [], noindex: pageNoindex = false } = Astro.props;

const canonical = pageNoindex ? undefined : new URL(Astro.url.pathname, Astro.site);
const fullTitle = title ? `${title} | ${firma.name}` : `Pellet drzewny z dostawą gratis do ${DARMOWA_DOSTAWA_KM} km – ${firma.name}`;
const desc = description ?? firma.description;
const noindex = pageNoindex || przedStartem || isPreview;

const og = await getImage({ src: ogSource, width: 1200, height: 630, format: "jpg" });
const ogUrl = new URL(og.src, Astro.site);

const home = absoluteUrl("/");
const localBusiness = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": firmaId,
  name: firma.name,
  legalName: firma.legalName,
  description: firma.description,
  url: home,
  image: ogUrl.toString(),
  telephone: firma.phone.href.replace("tel:", ""),
  email: firma.email,
  taxID: firma.nip,
  address: {
    "@type": "PostalAddress",
    streetAddress: firma.address.street,
    postalCode: firma.address.postalCode,
    addressLocality: firma.address.city,
    addressCountry: "PL",
  },
  geo: { "@type": "GeoCoordinates", latitude: firma.geo.lat, longitude: firma.geo.lng },
  openingHoursSpecification: firma.hours.map((h) => ({
    "@type": "OpeningHoursSpecification",
    dayOfWeek: h.days,
    opens: h.opens,
    closes: h.closes,
  })),
  areaServed: miejsca.map((m) => ({ "@type": "City", name: nazwaWlasna(m) })),
  hasMap: firma.googleMaps,
  sameAs: [firma.googleMaps],
};

const trail = breadcrumbsFor(Astro.url.pathname);
const breadcrumbList = trail.length > 1 && {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: trail.map((crumb, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: crumb.label,
    item: new URL(crumb.href, Astro.site).toString(),
  })),
};
const structuredData = [localBusiness, ...(breadcrumbList ? [breadcrumbList] : []), ...jsonLd];
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontLatinExt} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href("/apple-touch-icon.png")} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="sitemap" href={href("/sitemap-index.xml")} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={firma.name} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content={String(og.options.width)} />
    <meta property="og:image:height" content={String(og.options.height)} />
    <meta property="og:image:alt" content={`${firma.name}, ${addressLine()}`} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      structuredData.map((data) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />
      ))
    }
    <!-- Tells the CSS that scripts run, before the first paint: the drive on the home page reserves its scroll length only then. -->
    <script is:inline>document.documentElement.setAttribute("data-js", "");</script>
    {
      import.meta.env.DEV && (
        <script is:inline>
          // Dev only: compare palettes. ?paleta=materialy or ?paleta=obecna,
          // remembered per tab so links keep the choice.
          (() => {
            let p = new URLSearchParams(location.search).get("paleta");
            try {
              if (p) sessionStorage.setItem("paleta", p);
              else p = sessionStorage.getItem("paleta");
            } catch {}
            if (p === "materialy") document.documentElement.dataset.paleta = "materialy";
          })();
        </script>
      )
    }
  </head>
  <body class="flex min-h-svh flex-col">
    <a href="#tresc" class="skip-link">Przejdź do treści</a>
    <Header />
    {/* Content arrives from the right while scrolling (ruch.css); clip keeps
        that from widening the page, and unlike hidden it does not break the
        sticky drive stage. */}
    <main id="tresc" tabindex="-1" class="flex-1 overflow-x-clip">
      <slot />
    </main>
    <Footer />
    {
      import.meta.env.DEV && (
        <p class="paleta-przelacznik">
          Paleta: <a href="?paleta=obecna" class="paleta-obecna">obecna</a> /
          <a href="?paleta=materialy" class="paleta-materialy">z materiałów</a>
        </p>
      )
    }
    <script>
      import { initRuch } from "../components/ruch/ruch";
      initRuch();
    </script>
  </body>
</html>
