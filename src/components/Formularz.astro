---
/**
 * The frame both forms share: the fields come in the slot, this adds what
 * every form needs around them.
 *
 * - The trap field (honeypot): hidden from people, filled in by bots. The
 *   Pages Function in stage 3 drops any submission that has it filled.
 * - The privacy note: a consent checkbox where the data is used on consent
 *   (the contact form), otherwise a line that says what the data is for (the
 *   order, which needs it to be carried out). Both link the privacy policy,
 *   which names the same legal bases.
 * - The place for the Cloudflare Turnstile widget (stage 3).
 * - The submit button and a status line for the reply.
 *
 * `action` is the Pages Function that will receive the form. Until
 * `formularzeWlaczone` is on, the script below stops the submit once the
 * fields are checked and gives the phone number instead, so a reader never
 * takes an unsent form for a sent one. Without scripts the button stays
 * disabled and the same note shows above the fields, before anyone types.
 *
 * The script checks the fields itself, by the browser's own rules (required,
 * type, pattern, min), and writes what is wrong in Polish under each field,
 * all at once, then takes the reader to the first: the browser's bubbles
 * come one at a time, briefly, and in the browser's language. A field's
 * `data-blad` gives its own message for a wrong format. Without scripts the
 * browser's checks stay as they are.
 */
import { formularzeWlaczone } from "../data/strona";
import { firma } from "../data/firma";
import { strony } from "../data/nav";
import { href } from "../lib/url";

interface Props {
  /** The Pages Function's path, e.g. "/api/kontakt". */
  action: `/${string}`;
  submitLabel: string;
  /** What the data is for, ending a sentence: "odpowiedzi na wiadomość". */
  purpose: string;
  /** Ask for consent to that use; without it the form only says what the data is for. */
  consent?: boolean;
}

const { action, submitLabel, purpose, consent = false } = Astro.props;
---

<form method="post" action={href(action)} class="space-y-6" data-form data-live={String(formularzeWlaczone)}>
  {
    // TODO(produkcja): goes with formularzeWlaczone once the forms send (stage 3).
    !formularzeWlaczone && (
      <noscript>
        <p class="form-status mb-6 font-semibold">
          Formularz chwilowo nie działa. Zadzwoń:
          <a href={firma.phone.href}>{firma.phone.label}</a>.
        </p>
      </noscript>
    )
  }
  <slot />

  <div class="hp" aria-hidden="true">
    <label>
      Nie wypełniaj tego pola
      <input type="text" name="strona_www" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  {
    consent ? (
      <label class="check">
        <input type="checkbox" name="zgoda" value="tak" required />
        <span>
          Zgadzam się na przetwarzanie moich danych w celu {purpose}. Szczegóły w <a href={strony.polityka.href}>polityce prywatności</a>.{" "}
          <span class="req">*</span>
        </span>
      </label>
    ) : (
      <p class="text-sm text-ink-soft">
        Dane z formularza wykorzystamy do {purpose}. Szczegóły w <a href={strony.polityka.href}>polityce prywatności</a>.
      </p>
    )
  }

  {/* Stage 3: the Turnstile widget renders here. */}
  <div data-turnstile></div>

  <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
    <button type="submit" class="btn btn-primary" disabled={!formularzeWlaczone}>{submitLabel}</button>
    <p class="text-sm text-ink-soft"><span class="req">*</span> pole wymagane</p>
  </div>

  <p class="form-status font-semibold" role="status" data-form-status></p>

  {
    // TODO(produkcja): goes with formularzeWlaczone once the forms send (stage 3).
    !formularzeWlaczone && (
      <template data-form-nie-wysyla>
        Formularz chwilowo nie działa. Zadzwoń:
        <a href={firma.phone.href}>{firma.phone.label}</a>.
      </template>
    )
  }
</form>

<script>
  type Pole = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

  function komunikat(pole: Pole): string {
    const v = pole.validity;
    if (v.valueMissing) return pole.type === "checkbox" ? "Zaznacz zgodę, żeby wysłać wiadomość." : "Uzupełnij to pole.";
    if (v.typeMismatch && pole.type === "email") return "Wpisz adres e-mail, np. jan.kowalski@poczta.pl.";
    if (v.rangeUnderflow) return pole.dataset.blad ?? "Wybierz dzisiejszą lub późniejszą datę.";
    if (v.patternMismatch) return pole.dataset.blad ?? "Sprawdź, czy wszystko jest wpisane poprawnie.";
    return v.valid ? "" : "Sprawdź, czy wszystko jest wpisane poprawnie.";
  }

  /** Shows the field's message under it, or takes it away once it is right. */
  function pokaz(pole: Pole) {
    const id = `${pole.id || pole.name}-blad`;
    const tresc = komunikat(pole);
    let blad = document.getElementById(id);
    if (!tresc) {
      blad?.remove();
      pole.removeAttribute("aria-invalid");
      pole.setAttribute("aria-describedby", (pole.getAttribute("aria-describedby") ?? "").replace(id, "").trim());
      if (!pole.getAttribute("aria-describedby")) pole.removeAttribute("aria-describedby");
      return;
    }
    if (!blad) {
      blad = Object.assign(document.createElement("span"), { id, className: "blad" });
      // Last in the field's own box, which may be a cell of a grid; after a
      // checkbox's label, whose own grid has no room for it.
      const pudelko = pole.closest(".field");
      if (pudelko) pudelko.append(blad);
      else (pole.closest(".check") ?? pole).after(blad);
      pole.setAttribute("aria-describedby", `${pole.getAttribute("aria-describedby") ?? ""} ${id}`.trim());
    }
    blad.textContent = tresc;
    pole.setAttribute("aria-invalid", "true");
  }

  for (const form of document.querySelectorAll<HTMLFormElement>("[data-form]")) {
    form.noValidate = true;
    // Disabled in the HTML only for a reader without scripts; this one checks
    // the fields and gives the phone number on submit.
    form.querySelector("button[type=submit]")?.removeAttribute("disabled");
    const pola = [...form.querySelectorAll<Pole>("input, select, textarea")].filter((p) => p.name !== "strona_www" && p.willValidate);

    // A field already marked wrong is checked again as the reader fixes it.
    form.addEventListener("input", (e) => {
      const pole = e.target as Pole;
      if (pole.getAttribute("aria-invalid")) pokaz(pole);
    });
    form.addEventListener("change", (e) => pokaz(e.target as Pole));

    form.addEventListener("submit", (event) => {
      const zle = pola.filter((p) => !p.checkValidity());
      for (const p of pola) pokaz(p);
      if (zle.length) {
        event.preventDefault();
        zle[0]!.focus();
        return;
      }
      if (form.dataset.live === "true") return;
      event.preventDefault();
      const status = form.querySelector("[data-form-status]");
      const message = form.querySelector<HTMLTemplateElement>("template[data-form-nie-wysyla]");
      if (status && message) status.replaceChildren(message.content.cloneNode(true));
    });
  }
</script>
