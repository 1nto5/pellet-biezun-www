---
/**
 * The frame both forms share: the fields come in the slot, this adds what
 * every form needs around them.
 *
 * - The trap field (honeypot): hidden from people, filled in by bots. The
 *   Pages Function drops any submission that has it filled.
 * - The privacy note: a consent checkbox where the data is used on consent
 *   (the contact form), otherwise a line that says what the data is for (the
 *   order, which needs it to be carried out). Both link the privacy policy,
 *   which names the same legal bases.
 * - The Cloudflare Turnstile widget, the anti-spam check: it puts its token
 *   in a hidden field of the form, and the Pages Function checks it. Its
 *   script loads only here, so only on the pages with a form.
 * - The submit button and a status line for the reply.
 *
 * `action` is the Pages Function that receives the form (`functions/api/`).
 * Once the fields are checked, the script below sends the form itself and
 * asks for a JSON reply: on success it goes to the thank-you page the reply
 * names; on failure it says what went wrong in the status line, and
 * everything the reader typed stays. Without scripts the browser posts the
 * form and the function redirects: to the thank-you page, or back here with
 * `?blad=<code>`, which the script, where it runs, turns into the same
 * message.
 *
 * While `formularzeWlaczone` is off, the script stops the submit once the
 * fields are checked and gives the phone number instead, so a reader never
 * takes an unsent form for a sent one, and without scripts the same note
 * shows above the fields, before anyone types.
 *
 * Without scripts the button is always disabled: off, the form does not
 * send; on, the anti-spam check cannot run, so a post would only come back
 * with the fields emptied. A note above the fields says so.
 *
 * The script checks the fields itself, by the browser's own rules (required,
 * type, pattern, min), and writes what is wrong in Polish under each field,
 * all at once, then takes the reader to the first: the browser's bubbles
 * come one at a time, briefly, and in the browser's language. A field's
 * `data-blad` gives its own message for a wrong format. Without scripts the
 * browser's checks stay as they are.
 */
import { formularzeWlaczone, turnstileSiteKey } from "../data/strona";
import { firma } from "../data/firma";
import { strony } from "../data/nav";
import { href } from "../lib/url";

interface Props {
  /** The Pages Function's path, e.g. "/api/kontakt". */
  action: `/${string}`;
  submitLabel: string;
  /** What the data is for, ending a sentence: "odpowiedzi na wiadomość". */
  purpose: string;
  /** Ask for consent to that use; without it the form only says what the data is for. */
  consent?: boolean;
}

const { action, submitLabel, purpose, consent = false } = Astro.props;
---

<form method="post" action={href(action)} class="space-y-6" data-form data-live={String(formularzeWlaczone)}>
  {
    // Only while the forms are switched off (formularzeWlaczone in strona.ts).
    !formularzeWlaczone && (
      <noscript>
        <p class="form-status mb-6 font-semibold">
          Formularz chwilowo nie działa. Zadzwoń:
          <a href={firma.phone.href}>{firma.phone.label}</a>.
        </p>
      </noscript>
    )
  }
  {
    // The anti-spam check cannot run without scripts, so the form cannot be sent without them.
    formularzeWlaczone && (
      <noscript>
        <p class="form-status mb-6 font-semibold">
          Formularz wymaga włączonej obsługi JavaScript. Możesz też zadzwonić:
          <a href={firma.phone.href}>{firma.phone.label}</a>.
        </p>
      </noscript>
    )
  }
  <slot />

  <div class="hp" aria-hidden="true">
    <label>
      Nie wypełniaj tego pola
      <input type="text" name="strona_www" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  {
    consent ? (
      <label class="check">
        <input type="checkbox" name="zgoda" value="tak" required />
        <span>
          Zgadzam się na przetwarzanie moich danych w celu {purpose}. Szczegóły w <a href={strony.polityka.href}>polityce prywatności</a>.{" "}
          <span class="req">*</span>
        </span>
      </label>
    ) : (
      <p class="text-sm text-ink-soft">
        Dane z formularza wykorzystamy do {purpose}. Szczegóły w <a href={strony.polityka.href}>polityce prywatności</a>.
      </p>
    )
  }

  {/* Turnstile's script draws the widget in the box with the `cf-turnstile` class. */}
  {
    formularzeWlaczone ? (
      <div data-turnstile class="cf-turnstile" data-sitekey={turnstileSiteKey} data-language="pl" />
    ) : (
      <div data-turnstile />
    )
  }

  <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
    <button type="submit" class="btn btn-primary" disabled>{submitLabel}</button>
    <p class="text-sm text-ink-soft"><span class="req">*</span> pole wymagane</p>
  </div>

  <p class="form-status font-semibold" role="status" data-form-status></p>

  {
    // Only while the forms are switched off (formularzeWlaczone in strona.ts).
    !formularzeWlaczone && (
      <template data-form-nie-wysyla>
        Formularz chwilowo nie działa. Zadzwoń:
        <a href={firma.phone.href}>{firma.phone.label}</a>.
      </template>
    )
  }
  {
    // What the status line says for each error code of the Pages Function.
    formularzeWlaczone && (
      <>
        <template data-blad="pola">Sprawdź pola formularza i spróbuj ponownie.</template>
        <template data-blad="turnstile">
          Nie udało się potwierdzić, że nie jesteś robotem. Spróbuj ponownie albo zadzwoń:
          <a href={firma.phone.href}>{firma.phone.label}</a>.
        </template>
        <template data-blad="wysylka">
          Nie udało się wysłać formularza. Zadzwoń:
          <a href={firma.phone.href}>{firma.phone.label}</a>.
        </template>
      </>
    )
  }
</form>

{formularzeWlaczone && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />}

<script>
  type Pole = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

  // Turnstile's own script (api.js) sets this; it may still be loading, or blocked.
  declare const turnstile: { reset(widget: HTMLElement): void } | undefined;

  function komunikat(pole: Pole): string {
    const v = pole.validity;
    if (v.valueMissing) return pole.type === "checkbox" ? "Zaznacz zgodę, żeby wysłać wiadomość." : "Uzupełnij to pole.";
    if (v.typeMismatch && pole.type === "email") return "Wpisz adres e-mail, np. jan.kowalski@poczta.pl.";
    if (v.rangeUnderflow) return pole.dataset.blad ?? "Wybierz dzisiejszą lub późniejszą datę.";
    if (v.patternMismatch) return pole.dataset.blad ?? "Sprawdź, czy wszystko jest wpisane poprawnie.";
    return v.valid ? "" : "Sprawdź, czy wszystko jest wpisane poprawnie.";
  }

  /** Shows the field's message under it, or takes it away once it is right. */
  function pokaz(pole: Pole) {
    const id = `${pole.id || pole.name}-blad`;
    const tresc = komunikat(pole);
    let blad = document.getElementById(id);
    if (!tresc) {
      blad?.remove();
      pole.removeAttribute("aria-invalid");
      pole.setAttribute("aria-describedby", (pole.getAttribute("aria-describedby") ?? "").replace(id, "").trim());
      if (!pole.getAttribute("aria-describedby")) pole.removeAttribute("aria-describedby");
      return;
    }
    if (!blad) {
      blad = Object.assign(document.createElement("span"), { id, className: "blad" });
      // Last in the field's own box, which may be a cell of a grid; after a
      // checkbox's label, whose own grid has no room for it.
      const pudelko = pole.closest(".field");
      if (pudelko) pudelko.append(blad);
      else (pole.closest(".check") ?? pole).after(blad);
      pole.setAttribute("aria-describedby", `${pole.getAttribute("aria-describedby") ?? ""} ${id}`.trim());
    }
    blad.textContent = tresc;
    pole.setAttribute("aria-invalid", "true");
  }

  /** Writes the message for a Pages Function's error code into the status line; an unknown code reads as a failed send. */
  function pokazBlad(form: HTMLFormElement, kod: string | null) {
    const szablony = [...form.querySelectorAll<HTMLTemplateElement>("template[data-blad]")];
    const szablon = szablony.find((s) => s.dataset.blad === kod) ?? szablony.find((s) => s.dataset.blad === "wysylka");
    const status = form.querySelector("[data-form-status]");
    if (status && szablon) status.replaceChildren(szablon.content.cloneNode(true));
  }

  /** Sends the form to its Pages Function and acts on the JSON reply. */
  async function wyslij(form: HTMLFormElement) {
    const przycisk = form.querySelector<HTMLButtonElement>("button[type=submit]");
    // One click, one e-mail: the button waits for the reply.
    if (przycisk) przycisk.disabled = true;
    form.querySelector("[data-form-status]")?.replaceChildren();
    // Anything but a clear reply, e.g. no network, counts as a failed send.
    let blad = "wysylka";
    try {
      const odpowiedz = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } });
      const wynik = (await odpowiedz.json()) as { ok?: boolean; redirect?: string; blad?: string };
      // Only ever to a page of this site.
      const cel = wynik.ok && wynik.redirect ? new URL(wynik.redirect, location.href) : null;
      if (cel?.origin === location.origin) {
        location.assign(cel);
        return;
      }
      if (wynik.blad) blad = wynik.blad;
    } catch {
      // Stays "wysylka".
    }
    pokazBlad(form, blad);
    // A Turnstile token is good for one check only; the next try needs a new one.
    const widget = form.querySelector<HTMLElement>("[data-turnstile]");
    if (widget && typeof turnstile !== "undefined") turnstile.reset(widget);
    if (przycisk) przycisk.disabled = false;
  }

  for (const form of document.querySelectorAll<HTMLFormElement>("[data-form]")) {
    form.noValidate = true;
    // Disabled in the HTML for a reader without scripts; with them the form
    // checks the fields and sends, or gives the phone number while it is off.
    form.querySelector("button[type=submit]")?.removeAttribute("disabled");
    // Sent back by the Pages Function after a post without scripts.
    const kod = new URLSearchParams(location.search).get("blad");
    if (kod && form.dataset.live === "true") pokazBlad(form, kod);
    // Back from the thank-you page, the browser may show this page as it was
    // left, with the button still waiting for the reply.
    addEventListener("pageshow", (e) => {
      if (e.persisted) form.querySelector("button[type=submit]")?.removeAttribute("disabled");
    });
    const pola = [...form.querySelectorAll<Pole>("input, select, textarea")].filter((p) => p.name !== "strona_www" && p.willValidate);

    // A field already marked wrong is checked again as the reader fixes it.
    form.addEventListener("input", (e) => {
      const pole = e.target as Pole;
      if (pole.getAttribute("aria-invalid")) pokaz(pole);
    });
    form.addEventListener("change", (e) => pokaz(e.target as Pole));

    form.addEventListener("submit", (event) => {
      const zle = pola.filter((p) => !p.checkValidity());
      for (const p of pola) pokaz(p);
      if (zle.length) {
        event.preventDefault();
        zle[0]!.focus();
        return;
      }
      event.preventDefault();
      if (form.dataset.live === "true") {
        void wyslij(form);
        return;
      }
      const status = form.querySelector("[data-form-status]");
      const message = form.querySelector<HTMLTemplateElement>("template[data-form-nie-wysyla]");
      if (status && message) status.replaceChildren(message.content.cloneNode(true));
    });
  }
</script>
