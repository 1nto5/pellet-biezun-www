---
/**
 * The one `h1` of a page, with the breadcrumbs above it and an optional lead
 * below. Anything passed as a child sits under the lead. The livery stripes
 * close the head off from the content. It goes into the `header` slot of
 * `PageShell`.
 */
import Breadcrumbs from "./Breadcrumbs.astro";
import Pasy from "./Pasy.astro";

interface Props {
  title: string;
  lead?: string;
}

const { title, lead } = Astro.props;
---

<header>
  <Breadcrumbs />
  <h1 class="tytul-strony">{title}</h1>
  {lead && <p class="mt-5 max-w-prose text-lg font-medium">{lead}</p>}
  <slot />
  <Pasy class="mt-8" />
</header>
