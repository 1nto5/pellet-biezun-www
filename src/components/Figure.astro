---
/**
 * A photograph in its natural rectangle. `alt` describes the picture; `caption`
 * is the sentence under it, and only ever a sentence the client wrote.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  sizes?: string;
  widths?: number[];
  loading?: "lazy" | "eager";
  class?: string;
}

const {
  src,
  alt,
  caption,
  sizes = "(min-width: 48rem) 42rem, 100vw",
  widths = [480, 800, 1200],
  loading = "lazy",
  class: className,
} = Astro.props;
---

<figure class={className}>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    loading={loading}
    priority={loading === "eager"}
    class="w-full rounded-md"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
