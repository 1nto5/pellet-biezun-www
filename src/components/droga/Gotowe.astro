    d="M290.5 60h71a8.5 8.5 0 0 1 0 17h-31.5l-3 3.5l-3-3.5h-33.5a8.5 8.5 0 0 1 0-17z"
    style="fill:var(--color-sign)"
  />
  <circle cx="292" cy="68.5" r="5" fill="#fff" />
