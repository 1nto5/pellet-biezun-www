---
/**
 * The red telescopic loader that loads the truck, facing left, forks low on
 * the left, as the company loads at the hall.
 */
import { Image } from "astro:assets";
import { ladowarka } from "./obrazy";

interface Props {
  eager?: boolean;
}
const { eager = false } = Astro.props;
---

<Image src={ladowarka} width={520} widths={[160, 320, 520]} sizes="20vw" format="webp" alt="" loading={eager ? "eager" : "lazy"} />
