---
/**
 * One view of the road: pine forest and the roadside grass behind, the hall,
 * km posts, direction boards and the end-of-zone sign along the way, the
 * road, the truck, and the customer's house on the near side of the road.
 * The truck faces left and the world passes it to the right. `stan` sets
 * where everything stands (see `trasa.ts`), as custom properties: the drive
 * scrubbed by the scroll changes them as the reader scrolls, the still frames
 * keep them fixed. The loop on phones (`jazda.ts`) leaves them at the start
 * and moves each part by a transform of its own, so a new moving part needs
 * a line in its `ruchy` list too.
 *
 * Only a picture: the story it shows is told in text next to it. Its few
 * words (the km posts, the towns on the boards) are drawn by CSS from data
 * attributes, so they are not part of the page's text: the scene is there
 * four times, and its words would be read out of context.
 */
import Ciezarowka from "./Ciezarowka.astro";
import Hala from "./Hala.astro";
import Dom from "./Dom.astro";
import Ladowarka from "./Ladowarka.astro";
import KoniecStrefy from "./KoniecStrefy.astro";
import Paleta from "./Paleta.astro";
import { obrazy } from "./obrazy";
import { KM_DOJAZD, stanStyle, type Stan } from "./trasa";
import { tablice, slupki } from "./tablice";
import { DARMOWA_DOSTAWA_KM } from "../../data/miejsca";

interface Props {
  stan: Stan;
  /** The scene the scripts move (Droga.astro), drawn with its images loaded first. */
  live?: boolean;
}

const { stan, live = false } = Astro.props;

/** The two bands behind the road, as CSS backgrounds (droga.css). */
const pasy = [
  `--las:url(${obrazy.las.duzy})`,
  `--las-maly:url(${obrazy.las.maly})`,
  `--pobocze:url(${obrazy.pobocze.duzy})`,
  `--pobocze-male:url(${obrazy.pobocze.maly})`,
].join(";");
---

<div class="scena" aria-hidden="true" style={pasy}>
  <div class="scena-in" style={stanStyle(stan)} data-scena-live={live ? "" : undefined}>
    <div class="las"></div>
    <div class="pola"></div>
    <div class="swiat">
      <div class="w-hala"><Hala eager={live} /></div>
      {slupki.map((km) => <div class="w-slupek" style={`--at:${km}`} data-km={km} />)}
      {
        tablice.map((t) => (
          <div class="w-tablica" style={`--at:${t.naDrodze}`}>
            <div class="sign">
              {t.miasta.map((m) => (
                <p data-nazwa={m.nazwa} data-km={m.km} />
              ))}
            </div>
          </div>
        ))
      }
      <div class="w-koniec" style={`--at:${KM_DOJAZD}`}><KoniecStrefy km={DARMOWA_DOSTAWA_KM} /></div>
    </div>
    <div class="jezdnia"></div>
    <div class="swiat">
      <div class="w-widlak"><Ladowarka eager={live} /></div>
    </div>
    <div class="rig"><Ciezarowka eager={live} /></div>
    <div class="swiat">
      <div class="w-dom" style={`--at:${KM_DOJAZD}`}><Dom eager={live} /></div>
    </div>
    <div class="rig">
      <svg viewBox="0 0 240 108" overflow="visible" aria-hidden="true" focusable="false">
        <Paleta class="paleta-przed-domem" zWozkiem />
      </svg>
    </div>
  </div>
</div>
