---
/**
 * One view of the road: pine forest and the roadside grass behind, the hall,
 * direction boards and the free delivery sign along the way, the road, the
 * customer's house on the near side of the road, and the truck. The truck
 * faces left and the world passes it to the right; the house is drawn behind the truck, so the truck
 * passes in front of it, and never stands over it once parked. `stan` sets
 * where everything stands (see `trasa.ts`), as custom properties, which the
 * still frames keep. Every moving scene (the live stage, the phones' two)
 * leaves them at the start and is played by `jazda.ts`, which moves each
 * part by a transform of its own, so a new moving part needs a line in its
 * `ruchy` list too.
 *
 * Only a picture: the story it shows is told in text next to it. Its few
 * words (the towns' names on the boards) are drawn by CSS from data
 * attributes, so they are not part of the page's text: the scene is there
 * six times, and its words would be read out of context.
 */
import Ciezarowka from "./Ciezarowka.astro";
import Hala from "./Hala.astro";
import Dom from "./Dom.astro";
import ZnakDostawy from "./ZnakDostawy.astro";
import { obrazy } from "./obrazy";
import { KM_DOJAZD, stanStyle, type Stan } from "./trasa";
import { tablice } from "./tablice";

interface Props {
  stan: Stan;
  /** The scene the scripts move (Droga.astro), drawn with its images loaded first. */
  live?: boolean;
}

const { stan, live = false } = Astro.props;

/**
 * The two bands behind the road, as CSS backgrounds (droga.css). Quoted:
 * WebKit hands an unquoted url in a custom property back to the script
 * escaped, and the address the page read from it (Droga.astro) was broken.
 */
const pasy = [
  `--las:url("${obrazy.las.duzy}")`,
  `--las-maly:url("${obrazy.las.maly}")`,
  `--pobocze:url("${obrazy.pobocze.duzy}")`,
  `--pobocze-male:url("${obrazy.pobocze.maly}")`,
  `--las-avif:url("${obrazy.las.duzyAvif}")`,
  `--las-maly-avif:url("${obrazy.las.malyAvif}")`,
  `--pobocze-avif:url("${obrazy.pobocze.duzyAvif}")`,
  `--pobocze-male-avif:url("${obrazy.pobocze.malyAvif}")`,
].join(";");
---

<div class="scena" aria-hidden="true" style={pasy} data-proba-avif={live ? obrazy.probaAvif : undefined}>
  <div class="scena-in" style={stanStyle(stan)} data-scena-live={live ? "" : undefined}>
    <div class="las"></div>
    <div class="pola"></div>
    <div class="swiat">
      <div class="w-hala"><Hala eager={live} /></div>
      {
        tablice.map((t) => (
          <div class="w-tablica" style={`--at:${t.naDrodze}`}>
            <div class="sign">
              {t.miasta.map((m) => (
                <p data-nazwa={m.nazwa} />
              ))}
            </div>
          </div>
        ))
      }
      <div class="w-znak" style={`--at:${KM_DOJAZD}`}><ZnakDostawy /></div>
    </div>
    <div class="jezdnia"></div>
    <div class="swiat">
      <div class="w-dom" style={`--at:${KM_DOJAZD}`}><Dom eager={live} /></div>
    </div>
    <div class="rig rig-auto"><Ciezarowka eager={live} /></div>
  </div>
</div>
