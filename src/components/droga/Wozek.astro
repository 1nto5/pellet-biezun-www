---
/**
 * The electric pallet truck, in the truck drawing's units: its forks under
 * the pallet's bottom-left corner and pointing right, the way it takes the
 * pallet into the garage. It follows the pallet (`--pal-x`/`--pal-y`), backs
 * away from it by `--woz-dx` and shows as much as `--woz`. Its photo has the
 * forks on the left, so it is mirrored here; it has no lettering.
 */
import { obrazy } from "./obrazy";
---

<g class="wozek">
  <image href={obrazy.wozek} transform="matrix(-1 0 0 1 18 0)" x="0" y="-19.85" width="36" height="19.85" />
</g>
