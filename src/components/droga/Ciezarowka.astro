---
/**
 * The delivery truck: a photo of the company's Volvo FM with the box body,
 * cab on the left, facing the way it drives. 240 × 108 drawing units, ground
 * at the bottom edge; the photo is scaled so its length spans the 240 units
 * and the tyres stand on the ground.
 *
 * The wheels stay as they are in the photo: a turning wheel cut from a still
 * photo looks fake, and the road, the verge and the forest moving past
 * already show the drive. Driving off (`--odjazd`, see `trasa.ts`), the
 * whole truck leaves by the left edge.
 *
 * The photo is an <img> whose size fits the screen (a phone gets a far
 * smaller file than an SVG <image> could offer), placed over an empty
 * 240 × 108 drawing that gives the truck its height.
 */
import { Image } from "astro:assets";
import auto from "../../assets/droga/auto-fm.png";

interface Props {
  /**
   * Loads at once in the live scene, at the browser's own priority: the
   * scene waits for the truck before it shows (Droga.astro).
   */
  eager?: boolean;
}
const { eager = false } = Astro.props;

/**
 * Master photo: 2149 × 764 px, straightened so the box is level and all
 * tyres stand on one line (px y 761). 0.11168 units per px puts it at
 * y 23.01, 85.32 high, tyres on the ground at 108.
 */
const S = 240 / 2149;
const Y0 = 108 - 761 * S;
/** The photo's top edge, as a share of the drawing's height. */
const gora = `${Math.round((Y0 / 108) * 10000) / 100}%`;
---

<!-- The truck's shadow on the road (droga.css). -->
<div class="auto-cien"></div>
<!-- Empty: it only sizes the box the photo is placed in. -->
<svg class="auto" viewBox="0 0 240 108" overflow="visible" aria-hidden="true" focusable="false"></svg>
<Image
  src={auto}
  width={1800}
  widths={[600, 800, 1100, 1800]}
  sizes="(min-width: 64rem) 56vw, 90vw"
  format="webp"
  alt=""
  class="auto-foto"
  style={`top:${gora}`}
  loading={eager ? "eager" : "lazy"}
/>
