---
/**
 * The drive on the home page: the truck loads at the hall, drives past the
 * direction boards and unloads at a customer's house inside the free zone,
 * with the end-of-zone sign ahead, while the reader scrolls.
 *
 * Built so the page is complete without it moving. The HTML holds every stop
 * as text, most with a still frame of the scene, which is all a reader who
 * asked for reduced motion or has no scripts gets. Otherwise the CSS in
 * `droga.css` picks one of two ways to move (both known before the first
 * paint), and the script below follows it. Both are tied to the scroll: the
 * same scroll position always shows the same frame.
 *
 * - On a wide landscape screen, one sticky stage with the scroll length
 *   reserved under it; the script sets the scene from the scroll position.
 * - Elsewhere, phones above all, one scene pinned under the header with the
 *   stops' texts scrolling under it, each held below the scene for as long
 *   as its part of the drive takes (`--udzial`); the scroll sets the moment
 *   the scene should show, and its animations play there by themselves
 *   (`jazda.ts`), so they stay smooth on an iPhone.
 *
 * The last stop carries the order button and the phone: the reader who has
 * followed the delivery to the garage is the one ready to order.
 *
 * The slot is the hero. It sits in the same box as the stage, so the stage
 * can stand behind it from the first screen: the road starts under the hero.
 */
import "./droga.css";
import Scena from "./Scena.astro";
import Button from "../Button.astro";
import { firma } from "../../data/firma";
import { orderLink } from "../../data/nav";
import { DARMOWA_DOSTAWA_KM } from "../../data/miejsca";
import { start, czasKm, CZAS, KM_DOJAZD, type Stan } from "./trasa";
import { tablice, miastaWStrefie, kadry } from "./tablice";

interface Stop {
  id: string;
  /** The km post beside the heading; the stop between posts has none. */
  km?: number;
  /** When the stop's text shows on the 0–100 clock. */
  od: number;
  tytul: string;
  tekst: string;
  kadr?: Stan;
}

const pierwsza = tablice[0]!;

const stopy: Stop[] = [
  {
    id: "zaladunek",
    km: 0,
    od: 0,
    tytul: `Załadunek: ${firma.address.street}`,
    tekst: "Pellet czeka w hali we Władysławowie pod Bieżuniem. Stąd ładujemy palety na auta.",
    kadr: kadry.zaladunek,
  },
  {
    id: "w-drodze",
    od: CZAS.odjazd,
    tytul: "W drodze",
    tekst: "Dowozimy własnymi samochodami: od Iveco na 4 palety po ciężarówkę z naczepą na 26 palet. Każdy ma windę i elektryczny wózek paletowy.",
  },
  {
    id: "miasta",
    km: pierwsza.naDrodze,
    od: czasKm(pierwsza.naDrodze) - 3,
    tytul: "Miasta po drodze",
    tekst: "Drogowskazy pokazują miasta, do których dowozimy, i ich odległość od magazynu w linii prostej.",
    kadr: kadry.tablice,
  },
  {
    id: "na-miejscu",
    km: KM_DOJAZD,
    // From the moment the house comes into view.
    od: czasKm(KM_DOJAZD - 20),
    tytul: "Na miejscu, w strefie darmowej dostawy",
    tekst: `Do ok. ${DARMOWA_DOSTAWA_KM} km dowozimy gratis, dalej po uzgodnieniu.`,
    kadr: kadry.naMiejscu,
  },
  {
    id: "rozladunek",
    od: CZAS.postoj,
    tytul: "Rozładunek",
    tekst: "Paletę zdejmujemy windą i podwozimy elektrycznym wózkiem paletowym.",
    kadr: kadry.rozladunek,
  },
];

/** The stop's share of the drive, from its moment to the next stop's or the end. */
const udzial = (i: number) => Math.round(((stopy[i + 1]?.od ?? 100) - stopy[i]!.od) * 100) / 10000;
---

<div class="podroz" data-podroz>
  <slot />

  <section class="droga" aria-labelledby="droga-tytul" data-droga>
    <h2 id="droga-tytul" class="sr-only">Jak pellet jedzie do klienta</h2>

    <div class="droga-scena">
      <Scena stan={start} live />
      <p class="licznik" aria-hidden="true"><span data-licznik>0</span> km</p>
    </div>

    <ol class="stopy" role="list">
      {
        stopy.map((s, i) => (
          <li class="stop" data-stop data-od={s.od} style={`--udzial:${udzial(i)}`}>
            <div class="stop-tekst">
              {s.km !== undefined && (
                <p class="slupek">
                  <span>km</span> {s.km}
                </p>
              )}
              <h3>{s.tytul}</h3>
              <p class="stop-opis">{s.tekst}</p>
              {s.id === "rozladunek" && (
                <div class="stop-akcje">
                  <Button href={orderLink.href}>{orderLink.label}</Button>
                  <a href={firma.phone.href} class="stop-telefon">
                    <span class="sr-only">Zadzwoń: </span>
                    {firma.phone.label}
                  </a>
                </div>
              )}
              {s.id === "miasta" && (
                <ul class="stop-miasta" role="list">
                  {miastaWStrefie.map((m) => (
                    <li>
                      {m.nazwa} <span>{m.km} km</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
            {s.kadr && (
              <div class="kadr">
                <Scena stan={s.kadr} />
              </div>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  <div class="droga-dystans" data-dystans data-ruch-start aria-hidden="true"></div>
</div>

<script>
  import { stanAt, stanVars } from "./trasa";
  import { uruchomJazde, type Jazda } from "./jazda";

  const podroz = document.querySelector<HTMLElement>("[data-podroz]");
  const hero = podroz?.firstElementChild as HTMLElement | null | undefined;
  const droga = podroz?.querySelector<HTMLElement>("[data-droga]");
  const scena = podroz?.querySelector<HTMLElement>("[data-scena-live]");
  const rig = scena?.querySelector<HTMLElement>(".rig");
  const dystans = podroz?.querySelector<HTMLElement>("[data-dystans]");
  const licznik = podroz?.querySelector<HTMLElement>("[data-licznik]");
  const stopy = [...(podroz?.querySelectorAll<HTMLElement>("[data-stop]") ?? [])];
  const teksty = stopy.map((s) => s.querySelector<HTMLElement>(".stop-tekst"));

  if (podroz && hero && droga && scena && rig && dystans && licznik && stopy.length && teksty.every((t) => t)) {
    // The CSS decides which version shows and names it in `--droga`
    // (droga.css). A turned tablet or a resized window can switch between
    // them, so this is asked again on every refresh, and only then: asking
    // while scrolling would force a layout.
    type Tryb = "live" | "przypieta" | "nieruchoma";
    let tryb: Tryb | null = null;
    let live = false;
    let jazda: Jazda | null = null;
    const clamp = (x: number) => Math.min(1, Math.max(0, x));
    const od = stopy.map((s) => Number(s.dataset.od));

    // The stage is sticky in CSS; the drive runs over the spacer after it,
    // from the spacer's top reaching the bottom of the window (the stage has
    // then come fully under the header) to its bottom reaching it. Measured
    // on load, resize and layout changes, never while scrolling.
    let driveStart = 1;
    let driveEnd = 2;
    // While the hero is on screen the scene is drawn smaller (`--z`), so the
    // hall and the truck fit under the hero; it grows to full size as the
    // hero scrolls away.
    let z0 = 1;

    const measure = () => {
      const top = dystans.getBoundingClientRect().top + window.scrollY;
      driveStart = Math.max(1, top - window.innerHeight);
      driveEnd = Math.max(driveStart + 1, top + dystans.offsetHeight - window.innerHeight);

      scena.style.setProperty("--z", "1");
      // The layout width: the camera's zoom, a transform, must not count.
      const u1 = rig.offsetWidth / 60;
      // The tallest thing at the start, the hall, reaches 34 units up.
      const room = droga.clientHeight - hero.offsetHeight - 12;
      z0 = Math.min(1, Math.max(0.35, room / (34 * u1)));
    };

    // The whole scene is a function of the scroll position, set at once:
    // the same position always gives the same frame, whichever way the
    // reader came from.
    let shownStop = -2;
    let shownKm = -1;
    const render = () => {
      const y = window.scrollY;
      const z = z0 + (1 - z0) * clamp(y / driveStart);
      const t = 100 * clamp((y - driveStart) / (driveEnd - driveStart));
      const stan = stanAt(t);
      for (const [k, v] of Object.entries(stanVars(stan))) scena.style.setProperty(k, v);
      scena.style.setProperty("--z", String(z));

      const index = y < driveStart + 2 ? -1 : od.findLastIndex((o) => t >= o);
      if (index !== shownStop) {
        stopy.forEach((s, i) => s.classList.toggle("is-active", i === index));
        podroz.classList.toggle("is-driving", index >= 0);
        shownStop = index;
      }
      const km = Math.round(stan.km);
      if (km !== shownKm) {
        licznik.textContent = String(km);
        shownKm = km;
      }
    };

    // Pinned (droga.css): each stop's text is held under the scene, at its
    // sticky `top`, while its part of the drive plays. The drive reaches a
    // stop's moment as the stop's top comes to that line, and its end as the
    // last text is about to be pushed away by the end of the drive. The axis
    // holds those pairs of a scroll position and a moment, both growing;
    // between two of them the drive moves evenly with the scroll.
    type Os = [y: number, t: number][];
    let os: Os = [[0, 0]];
    const zmierzOs = (): Os => {
      const linia = parseFloat(getComputedStyle(teksty[0]!).top);
      const y = window.scrollY - linia;
      const os: Os = stopy.map((s, i) => [Math.round(s.getBoundingClientRect().top + y), od[i]!]);
      const ostatni = stopy.at(-1)!;
      const koniec = ostatni.getBoundingClientRect().bottom - parseFloat(getComputedStyle(ostatni).paddingBottom) - teksty.at(-1)!.offsetHeight;
      os.push([Math.max(os.at(-1)![0], Math.round(koniec + y)), 100]);
      return os;
    };
    const chwila = (y: number): number => {
      if (y <= os[0]![0]) return os[0]![1];
      for (let i = 1; i < os.length; i++) {
        const [y1, t1] = os[i]!;
        if (y <= y1) {
          const [y0, t0] = os[i - 1]!;
          return y1 === y0 ? t1 : t0 + ((t1 - t0) * (y - y0)) / (y1 - y0);
        }
      }
      return os.at(-1)![1];
    };
    // The scroll only sets where the drive goes; it plays there by itself.
    const przewin = () => jazda?.jedz(chwila(window.scrollY));

    const refresh = () => {
      const nowy = (getComputedStyle(podroz).getPropertyValue("--droga").trim() || "nieruchoma") as Tryb;
      live = nowy === "live";

      // The pinned drive is set up for one scene width; another width, or
      // another version, sets it up again.
      if (nowy === "przypieta") {
        os = zmierzOs();
        if (!jazda || jazda.szerokosc !== scena.clientWidth) {
          jazda?.zatrzymaj();
          jazda = uruchomJazde(scena, (km) => (licznik.textContent = String(km)));
          // A new scene starts where the scroll already is, not from the hall.
          jazda.ustaw(chwila(window.scrollY));
        }
      } else if (jazda) {
        jazda.zatrzymaj();
        jazda = null;
      }
      if (nowy !== tryb) {
        podroz.classList.toggle("is-driving", nowy === "przypieta");
        shownStop = -2;
        shownKm = -1;
        tryb = nowy;
      }

      if (live) {
        measure();
        render();
      } else {
        przewin();
      }
      podroz.classList.add("is-ready");
    };

    refresh();
    window.addEventListener("scroll", () => (live ? render() : przewin()), { passive: true });
    window.addEventListener("resize", refresh);
    // Heights change when the font and the images arrive.
    window.addEventListener("load", refresh);
    document.fonts?.ready.then(refresh);
    new ResizeObserver(refresh).observe(podroz);
  }
</script>
