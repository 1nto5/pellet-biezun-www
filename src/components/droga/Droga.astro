---
/**
 * The drive on the home page: the truck leaves the hall, drives past the
 * direction boards and delivers to a customer's house inside the free zone,
 * with the free delivery sign ahead, while the reader scrolls. It carries the
 * page's content: one stop per screen, each with a heading and what the
 * page has to say there (the products at the hall, the fleet on the road,
 * the towns, the delivery terms, the order). The content comes from the page
 * as a named slot per stop, so its markup and styles stay with the page.
 *
 * Built so the page is complete without it moving. The HTML holds every stop
 * with its heading, its content and a still frame of the scene, which is all a
 * reader who asked for reduced motion or has no scripts gets. Otherwise the
 * CSS in `droga.css` picks one of two ways to move (both known before the
 * first paint), and the script below follows it. Both are tied to the
 * scroll: the same scroll position always shows the same frame.
 *
 * - On a wide landscape screen, one sticky stage with the scroll length
 *   reserved under it, one stop at a time in the sky above the scene: the
 *   heading over the content, across the page's width. Each stop gets the same
 *   stretch of scroll, whatever its share of the drive's clock, so a stop
 *   with a lot to read stays as long as one with little.
 * - Elsewhere, phones above all, one scene pinned under the header with the
 *   stops scrolling freely under it, the drive reaching each stop's moment
 *   as the stop comes up to the scene.
 *
 * In both the scroll only sets the moment the scene should show, and its
 * animations play there by themselves (`jazda.ts`): they move nothing but
 * transforms, so they stay smooth on an iPhone and never shift the page's
 * layout.
 *
 * The last stop carries the order: the reader who has followed the delivery
 * to the house is the one ready to order.
 *
 * The default slot is the hero. It sits in the same box as the stage, so the
 * stage can stand behind it from the first screen: the road starts under the
 * hero.
 */
import "./droga.css";
import Scena from "./Scena.astro";
import { start, stanAt, czasKm, CZAS, KM_DOJAZD, type Stan } from "./trasa";
import { tablice, kadry } from "./tablice";

interface Stop {
  /** Also the name of the page's slot with the stop's content. */
  id: string;
  /** When the stop starts on the 0–100 clock. */
  od: number;
  tytul: string;
  kadr: Stan;
}

const pierwsza = tablice[0]!;

const stopy: Stop[] = [
  {
    id: "zaladunek",
    od: 0,
    tytul: "Załadunek",
    kadr: kadry.zaladunek,
  },
  {
    id: "w-drodze",
    od: CZAS.odjazd,
    tytul: "W drodze",
    // Up to speed, the hall going out of sight behind.
    kadr: stanAt(CZAS.rozped),
  },
  {
    id: "miasta",
    od: czasKm(pierwsza.naDrodze) - 3,
    tytul: "Miasta po drodze",
    kadr: kadry.tablice,
  },
  {
    id: "na-miejscu",
    // From the moment the house comes into view.
    od: czasKm(KM_DOJAZD - 20),
    tytul: "Na miejscu",
    kadr: kadry.naMiejscu,
  },
  {
    id: "dostarczone",
    od: CZAS.postoj,
    tytul: "Zamówienie",
    kadr: kadry.koniec,
  },
];
---

<div class="podroz" data-podroz>
  <slot />

  <section class="droga" aria-label="Jak pellet jedzie do klienta" data-droga>
    <div class="droga-tor" data-droga-tor>
      <div class="droga-scena" data-droga-scena>
        <Scena stan={start} live />
      </div>
    </div>

    <ol class="stopy" role="list" data-stopy>
      {
        stopy.map((s) => (
          <li class="stop" data-stop data-od={s.od}>
            <div class="stop-tekst">
              <h2>{s.tytul}</h2>
            </div>
            <div class="stop-tresc">
              <slot name={s.id} />
            </div>
            <div class="kadr">
              <Scena stan={s.kadr} />
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <div class="droga-dystans" data-dystans data-ruch-start aria-hidden="true" style={`--odcinki:${stopy.length}`}></div>
</div>

<script>
  import { uruchomJazde, type Jazda } from "./jazda";

  const podroz = document.querySelector<HTMLElement>("[data-podroz]");
  const hero = podroz?.firstElementChild as HTMLElement | null | undefined;
  const droga = podroz?.querySelector<HTMLElement>("[data-droga]");
  const scena = podroz?.querySelector<HTMLElement>("[data-scena-live]");
  const rig = scena?.querySelector<HTMLElement>(".rig");
  const dystans = podroz?.querySelector<HTMLElement>("[data-dystans]");
  const tor = podroz?.querySelector<HTMLElement>("[data-droga-tor]");
  const pudelko = podroz?.querySelector<HTMLElement>("[data-droga-scena]");
  const lista = podroz?.querySelector<HTMLElement>("[data-stopy]");
  const stopy = [...(podroz?.querySelectorAll<HTMLElement>("[data-stop]") ?? [])];

  if (podroz && hero && droga && scena && rig && dystans && tor && pudelko && lista && stopy.length) {
    // The CSS decides which version shows and names it in `--droga`
    // (droga.css). A turned tablet or a resized window can switch between
    // them, so this is asked again on every refresh, and only then: asking
    // while scrolling would force a layout.
    type Tryb = "live" | "przypieta" | "nieruchoma";
    let tryb: Tryb | null = null;
    let live = false;
    let jazda: Jazda | null = null;
    const clamp = (x: number) => Math.min(1, Math.max(0, x));
    const od = stopy.map((s) => Number(s.dataset.od));

    // Both versions map the scroll to the drive's moment along an axis:
    // pairs of a scroll position and a moment, both growing, one pair where
    // each stop starts and one where the drive ends. Between two of them the
    // drive moves evenly with the scroll. Measured on load, resize and
    // layout changes, never while scrolling.
    type Os = [y: number, t: number][];
    let os: Os = [[0, 0]];
    const chwila = (y: number): number => {
      if (y <= os[0]![0]) return os[0]![1];
      for (let i = 1; i < os.length; i++) {
        const [y1, t1] = os[i]!;
        if (y <= y1) {
          const [y0, t0] = os[i - 1]!;
          return y1 === y0 ? t1 : t0 + ((t1 - t0) * (y - y0)) / (y1 - y0);
        }
      }
      return os.at(-1)![1];
    };

    // Live: the stage is sticky in CSS; the drive runs over the spacer after
    // it, from the spacer's top reaching the bottom of the window (the stage
    // has then come fully under the header). The spacer is cut into one
    // stretch per stop, a window's height each: the stop shows for the whole
    // stretch while the drive goes from its moment to the next stop's. Read
    // by its clock alone, the products would show only while the truck
    // stands at the hall, a few steps of the wheel.
    const ODCINEK = 1;
    let driveStart = 1;
    // While the hero is on screen the scene is drawn smaller, so the hall
    // and the truck fit under the hero; it grows as the hero scrolls away,
    // to the size that leaves the stops' content room above it (`zDrive`),
    // and keeps that size for the whole drive. A scale about the scene's
    // bottom centre, as a transform: drawn smaller by its layout, the scene
    // moved the page's layout on every scroll step (layout shift); about
    // the origin droga.css gives the scene.
    let z0 = 1;
    let zDrive = 1;
    let u1 = 1;
    let szerokosc = 1;
    let shownZ = -1;
    // How many times the scene's own width the picture is during the
    // drive: the truck drives off past its edge (jazda.ts).
    let widok = 1;

    const measure = () => {
      const odcinek = Math.round(ODCINEK * window.innerHeight);
      const dlugosc = `${odcinek * stopy.length}px`;
      // Only a real change: the spacer's height resizes the box the
      // ResizeObserver below watches.
      if (dystans.style.getPropertyValue("--dlugosc") !== dlugosc) dystans.style.setProperty("--dlugosc", dlugosc);
      const top = dystans.getBoundingClientRect().top + window.scrollY;
      driveStart = Math.max(1, top - window.innerHeight);
      os = stopy.map((_s, i): [number, number] => [driveStart + i * odcinek, od[i]!]);
      os.push([driveStart + stopy.length * odcinek, 100]);

      szerokosc = scena.clientWidth;
      u1 = rig.offsetWidth / 60;
      // The tallest thing at the start, the hall, reaches 34 units up: it
      // has to fit under the hero.
      const room = droga.clientHeight - hero.offsetHeight - 12;
      z0 = Math.min(1, Math.max(0.35, room / (34 * u1)));
      // During the drive the direction boards, high on their posts, and the
      // free delivery sign stand taller than the hall: sized for the hall
      // alone, the boards covered the towns' list on a laptop's screen. So
      // the drive's one size is set by the tallest of them, read from the
      // layout (transforms left out) in units of the scene at full size.
      const wysokosc = Math.max(
        34,
        ...[...scena.querySelectorAll<HTMLElement>(".w-hala, .w-tablica, .w-znak")].map((el) => (scena.clientHeight - el.offsetTop) / u1),
      );
      const zmiesci = (droga.clientHeight - lista.offsetHeight - 12) / (wysokosc * u1);
      zDrive = Math.min(1, Math.max(0.35, zmiesci));
      widok = Math.round((1 / zDrive) * 1000) / 1000;
      shownZ = -1;
    };
    const pomniejsz = (z: number) => {
      if (z === shownZ) return;
      scena.style.scale = String(z);
      shownZ = z;
    };

    // The scroll position sets the moment of the drive; the scene plays
    // there by itself (jazda.ts), the stop and the size follow the scroll at
    // once. The stop is the one whose stretch the scroll is in.
    let shownStop = -2;
    const stopLive = (y: number) => (y < os[0]![0] + 2 ? -1 : Math.min(stopy.length - 1, os.findLastIndex(([y0]) => y >= y0)));
    const render = () => {
      const y = window.scrollY;
      pomniejsz(Math.round((z0 + (zDrive - z0) * clamp(y / driveStart)) * 1000) / 1000);
      jazda?.jedz(chwila(y));

      const index = stopLive(y);
      if (index !== shownStop) {
        stopy.forEach((s, i) => s.classList.toggle("is-active", i === index));
        shownStop = index;
      }
    };

    // A link in a stop not on show can still take the focus (from the
    // keyboard): the page then scrolls to that stop's stretch, so the stop
    // it is in shows. Not when it is already there, or a click on a link of
    // the stop on show would move the page.
    podroz.addEventListener("focusin", (e) => {
      if (!live) return;
      const i = stopy.findIndex((s) => s.contains(e.target as Node));
      // In its stretch already; past the drive's end the last stop still
      // counts as shown, but the page has scrolled on and its top is gone.
      const y = window.scrollY;
      if (i < 0 || (y >= os[i]![0] && y < os[i + 1]![0])) return;
      window.scrollTo({ top: Math.round((os[i]![0] + os[i + 1]![0]) / 2), behavior: "instant" });
    });

    // Pinned (droga.css): the stops scroll freely under the scene. The drive
    // reaches a stop's moment as the stop's top comes up to the scene's
    // bottom (the last stop's earlier, below), and its end as the last
    // stop's top reaches it. The scene then scrolls away with that stop: on a
    // short phone the stop is taller than the room under the scene, and held
    // any longer the scene would cover its order button.
    const zmierzOs = (): Os => {
      const rem = parseFloat(getComputedStyle(document.documentElement).fontSize);
      const linia = parseFloat(getComputedStyle(pudelko).top) + pudelko.offsetHeight + rem;
      const y = window.scrollY - linia;
      const os: Os = stopy.map((s, i) => [Math.round(s.getBoundingClientRect().top + y), od[i]!]);
      // The last stop is about as tall as the room under the scene, so from
      // its top at the line to its end there is next to no scroll, and the
      // delivery (the truck standing at the house, driving off) would flash
      // by. Its moment
      // starts earlier instead, half the room before its top reaches the
      // line: the delivery plays while the order rises into view.
      const doNa = os.at(-1)![0];
      const wczesniej = Math.round((window.innerHeight - linia) / 2);
      os[os.length - 1]![0] = Math.max(os.at(-2)?.[0] ?? 0, doNa - wczesniej);
      os.push([doNa, 100]);

      // The scene stays pinned through its track (`--tor`, droga.css) and
      // leaves as the drive ends: it scrolls away together with the last
      // stop, the order button never cut by the scene.
      const torOd = tor.getBoundingClientRect().top + window.scrollY - parseFloat(getComputedStyle(pudelko).top);
      tor.style.setProperty("--tor", `${Math.max(0, Math.round(os.at(-1)![0] - torOd))}px`);
      return os;
    };
    // The scroll only sets where the drive goes; it plays there by itself.
    const przewin = () => jazda?.jedz(chwila(window.scrollY));

    const refresh = () => {
      const nowy = (getComputedStyle(podroz).getPropertyValue("--droga").trim() || "nieruchoma") as Tryb;
      live = nowy === "live";

      // Either moving version sets the drive up for one scene size; another
      // size, or another version, sets it up again. The live scene, drawn
      // smaller at first, has its bands widened to still reach its edges.
      if (nowy !== tryb || (jazda && (jazda.szerokosc !== scena.clientWidth || Math.abs(jazda.u - rig.offsetWidth / 60) > 0.05))) {
        jazda?.zatrzymaj();
        jazda = null;
        scena.style.removeProperty("scale");
        tor.style.removeProperty("--tor");
        stopy.forEach((s) => s.classList.remove("is-active"));
        shownStop = -2;
        tryb = nowy;
      }
      if (live) {
        measure();
        // The truck drives off past the edge of one picture.
        if (jazda && jazda.widok !== widok) {
          jazda.zatrzymaj();
          jazda = null;
        }
      } else if (nowy === "przypieta") os = zmierzOs();
      if (!jazda && nowy !== "nieruchoma") zbuduj();

      if (live) render();
      else przewin();
    };

    // Setting the drive up takes a moment of the page's script, so the
    // first setup waits until the browser is idle (or a second at most); till
    // then the scene shows its start as drawn. A new setup, for a resized
    // window, comes at once: waiting, the scene showed its start for a frame
    // on every step of the resize. A new scene starts where the scroll
    // already is, not from the hall.
    let czeka = false;
    let zbudowana = false;
    const zbuduj = () => {
      if (czeka) return;
      czeka = true;
      const teraz = () => {
        czeka = false;
        if (jazda || tryb === "nieruchoma" || tryb === null) return;
        jazda = uruchomJazde(scena, live ? szerokosc * widok : 0, live ? widok : 1);
        jazda.ustaw(chwila(window.scrollY));
        zbudowana = true;
      };
      if (zbudowana) teraz();
      else if ("requestIdleCallback" in window) requestIdleCallback(teraz, { timeout: 1000 });
      else setTimeout(teraz, 300);
    };

    // The scene shows once its photos are in, not piece by piece: the
    // truck, the hall and the forest band this screen gets;
    // 2.5 s on at the latest. The band is a CSS background, so the script
    // loads the same file to know: AVIF where the browser takes it and the
    // CSS offers it (droga.css), else WebP; the phone's size or the full one.
    const wczytaj = (src: string) => Object.assign(new Image(), { src }).decode();
    const scenaBox = scena.parentElement!;
    const adres = (zmienna: string) => scenaBox.style.getPropertyValue(zmienna).match(/url\((.*)\)/)?.[1] ?? "";
    const probaAvif = scenaBox.dataset.probaAvif;
    const avif =
      probaAvif && CSS.supports("background-image", 'image-set(url("x.avif") type("image/avif"))')
        ? wczytaj(probaAvif).then(() => true, () => false)
        : Promise.resolve(false);
    const pasmo = avif.then((tak) =>
      wczytaj(adres(`--las${window.matchMedia("(min-width: 48rem)").matches ? "" : "-maly"}${tak ? "-avif" : ""}`)),
    );
    const zdjecia = [...scena.querySelectorAll<HTMLImageElement>(".auto-foto, .w-hala img")];
    Promise.race([
      Promise.allSettled([...zdjecia.map((img) => img.decode()), pasmo]),
      new Promise((gotowe) => setTimeout(gotowe, 2500)),
    ]).then(() => podroz.classList.add("is-ready"));

    refresh();
    window.addEventListener("scroll", () => (live ? render() : przewin()), { passive: true });
    window.addEventListener("resize", refresh);
    // Heights change when the font and the images arrive.
    window.addEventListener("load", refresh);
    document.fonts?.ready.then(refresh);
    // The stops' content sets the live scene's size, and stands apart from
    // the page's flow there, so it is watched on its own.
    const obserwator = new ResizeObserver(refresh);
    obserwator.observe(podroz);
    obserwator.observe(lista);
  }
</script>
