---
/**
 * A pallet of 15 kg bags under its film hood, bottom-left corner at 0,0 in
 * the truck drawing's units, placed by `--pal-x`/`--pal-y`.
 */
import { obrazy } from "./obrazy";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<g class:list={["paleta", className]}>
  <image href={obrazy.paleta} x="0" y="-24.5" width="18" height="24.5" />
</g>
