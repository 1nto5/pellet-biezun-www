---
/**
 * The warehouse hall at Władysławowo 10, side elevation: open door with
 * pallets inside at its left end, towards the truck's back. The green
 * PELLET BIEŻUŃ board is drawn over the plain wall right of the door, under
 * the eaves; the photo itself has no lettering.
 */
import { Image } from "astro:assets";
import { hala } from "./obrazy";
import { firma } from "../../data/firma";

interface Props {
  /**
   * The live scene shows the hall on the first screen, so it loads at once,
   * but after the headline's font: the headline is what the page is waited on.
   */
  eager?: boolean;
}
const { eager = false } = Astro.props;

const [pellet, miasto] = firma.znak;
---

<Image
  src={hala}
  width={1620}
  widths={[480, 960, 1620]}
  sizes="62vw"
  format="webp"
  alt=""
  loading={eager ? "eager" : "lazy"}
  fetchpriority={eager ? "low" : undefined}
/>
<svg class="hala-tablica" viewBox="0 0 112 34" aria-hidden="true" focusable="false">
  <rect width="112" height="34" rx="2.5" style="fill:var(--color-sign)" />
  <rect x="2.5" y="2.5" width="107" height="29" rx="1.5" fill="none" stroke="#fff" stroke-width="1.2" />
  <text x="56" y="19.5" class="znak-duzy" text-anchor="middle">{pellet.toUpperCase()}</text>
  <text x="56" y="28.5" class="znak-maly" text-anchor="middle">{miasto.toUpperCase()}</text>
</svg>
