---
/**
 * Three columns of facts, all from `data/firma.ts`, and a bottom line with the
 * registered name, the tax number and the privacy policy. White on asphalt,
 * with the road's centre line along the top.
 */
import { firma, hoursRange } from "../data/firma";
import { mainNav, strony } from "../data/nav";

const year = new Date().getFullYear();
---

<footer class="site-footer mt-auto">
  <div class="page-wrap grid gap-10 py-12 md:grid-cols-3 md:py-16">
    <div>
      <p class="text-lg font-extrabold">{firma.name}</p>
      <address class="mt-3 soft">
        {firma.address.street}<br />
        {firma.address.postalCode}
        {firma.address.city}<br />
        tel. <a href={firma.phone.href}>{firma.phone.label}</a><br />
        <a href={`mailto:${firma.email}`}>{firma.email}</a>
      </address>
    </div>

    <div>
      <p class="text-lg font-extrabold">Godziny otwarcia</p>
      <dl class="mt-3 soft">
        {
          firma.hours.map((h) => (
            <div class="flex justify-between gap-4 sm:max-w-72">
              <dt>{h.label}</dt>
              <dd>{hoursRange(h)}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-2 text-sm soft">{firma.closedNote}</p>
    </div>

    <div>
      <p id="footer-strony" class="text-lg font-extrabold">Strony</p>
      <nav aria-labelledby="footer-strony">
        <ul role="list" class="mt-3 grid grid-cols-2 gap-x-6 gap-y-1">
          {
            [strony.home, ...mainNav, strony.zamowienie].map((item) => (
              <li>
                <a href={item.href} class="inline-block py-0.5">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <div class="border-t border-white/25">
    <div
      class="page-wrap flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2 py-4 text-sm soft"
    >
      <p>© {year} {firma.legalName}, NIP {firma.nip}</p>
      <p class="flex flex-wrap gap-x-6">
        <a href={strony.polityka.href}>{strony.polityka.label}</a>
        <span>
          Strona: <a href="https://adrianantosiak.pl" rel="author noopener noreferrer" target="_blank"
            >Adrian Antosiak<span class="sr-only"> (otwiera się w nowej karcie)</span></a
          >
        </span>
      </p>
    </div>
  </div>
</footer>
