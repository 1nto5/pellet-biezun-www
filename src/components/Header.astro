---
/**
 * The top of every page, pinned there from `lg` up: one row with the company
 * name set like its sign, the sections on a green direction board from `lg`
 * up, the „Zamów pellet" button and the light/dark button. Below `lg` the
 * sections live behind a menu button, in a native <dialog> that slides in from
 * the left as a drawer under the header. The same button, a tap outside, a
 * swipe to the left or Escape closes it.
 */
import { Image } from "astro:assets";
import { mainNav, orderLink, strony, activeSection } from "../data/nav";
import autoFm from "../assets/droga/auto-fm.png";
import { firma } from "../data/firma";
import { BEZ_ZALICZEK, pasekBezZaliczek } from "../data/zaliczki";

const section = activeSection(Astro.url.pathname);
/** "Pellet Bieżuń" → the two lines of the sign. */
const wordmark = firma.znak;
// "page" for the page itself; "true" for the section a deeper page belongs
// to, such as "Mapa dystrybucji" on a town's page.
const current = (href: string) => (href === Astro.url.pathname ? "page" : href === section?.href ? "true" : undefined);
// The theme button's icon: a moon on a light page, a sun on a dark one
// (global.css shows one by `aria-pressed`).
const ikonaMotywu = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true">
  <path class="motyw-ksiezyc" d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>
  <g class="motyw-slonce">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path>
  </g>
</svg>`;
---

<header class="site-header">
  <div class="header-surface" data-surface>
    {/* Inside the surface, so `--header-height` counts it and the home
        page's first screen still fits; pinned with the row from `lg` up. */}
    {
      pasekBezZaliczek && (
        <p class="pasek-zaliczki">
          <span class="page-wrap block">
            <strong>{BEZ_ZALICZEK}</strong> W razie wątpliwości zadzwoń:{" "}
            <a href={firma.phone.href}>{firma.phone.label}</a>
          </span>
        </p>
      )
    }
    <div class="pinned-row page-wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
      <a href={strony.home.href} class="marka" aria-label={firma.name}>
        <span class="marka-pellet" aria-hidden="true">{wordmark[0]}</span>
        <span class="marka-miasto" aria-hidden="true">{wordmark[1]}</span>
      </a>

      <div class="flex items-center gap-x-5">
        <nav aria-label="Menu główne" class="sign nav-board hidden lg:block">
          <ul role="list" class="flex">
            {
              mainNav.map((item) => (
                <li>
                  <a href={item.href} class="nav-link" aria-current={current(item.href)}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="akcje flex items-center gap-3">
          <a
            href={orderLink.href}
            class="btn btn-primary btn-sm"
            aria-current={current(orderLink.href)}>{orderLink.label}</a
          >
          <button type="button" class="tool motyw-toggle" data-motyw aria-pressed="false">
            <Fragment set:html={ikonaMotywu} />
            <span class="sr-only">Tryb nocny</span>
          </button>
          {/* Pressed or not before the first paint, so the icon does not
              change in view once the module below runs. */}
          <script is:inline>
            (function (b) {
              var t = document.documentElement.getAttribute("data-theme");
              var ciemny = t ? t === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
              b.setAttribute("aria-pressed", String(ciemny));
            })(document.currentScript.previousElementSibling);
          </script>
          <button type="button" class="tool menu-toggle" data-menu-open aria-haspopup="dialog" aria-expanded="false">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" aria-hidden="true">
              <path class="menu-ikona-otworz" d="M4 6h16M4 12h16M4 18h16"></path>
              <path class="menu-ikona-zamknij" d="M6 6l12 12M18 6L6 18"></path>
            </svg>
            <span class="sr-only">Menu</span>
          </button>
        </div>
      </div>
    </div>
    <!-- The road band: the real truck, small, drives right to left along it as the page scrolls (ruch.ts). -->
    <div class="pasek" data-pasek aria-hidden="true">
      <div class="pasek-auto">
        <Image src={autoFm} alt="" width={128} widths={[64, 128]} sizes="2.4rem" loading="eager" />
      </div>
    </div>
  </div>

  <div class="menu-backdrop" data-menu-backdrop hidden></div>
  <dialog class="menu" data-menu aria-label="Menu główne" tabindex="-1">
    <p class="pb-3">
      Telefon: <a href={firma.phone.href} class="inline-block py-2 text-xl font-extrabold">{firma.phone.label}</a>
    </p>
    <nav aria-label="Menu" class="mt-2">
      <ul role="list">
        <li><a href={strony.home.href} aria-current={current(strony.home.href)}>{strony.home.label}</a></li>
        {
          mainNav.map((item) => (
            <li>
              <a href={item.href} aria-current={current(item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    {/* On the narrowest phones the header row has no room for the theme
        button (global.css), so it is here instead. */}
    <button type="button" class="menu-motyw" data-motyw aria-pressed="false">
      <Fragment set:html={ikonaMotywu} />
      Tryb nocny
    </button>
  </dialog>
</header>

<script>
  const doc = document.documentElement;
  const menu = document.querySelector<HTMLDialogElement>("[data-menu]");
  const backdrop = document.querySelector<HTMLElement>("[data-menu-backdrop]");
  const open = document.querySelector<HTMLButtonElement>("[data-menu-open]");
  const surface = document.querySelector<HTMLElement>("[data-surface]");
  // The theme button in the header row and its twin in the drawer.
  const motywy = [...document.querySelectorAll<HTMLButtonElement>("[data-motyw]")];

  // Light or dark. The page follows the system until the reader presses the
  // button; from then on the choice is kept (`motyw` in localStorage) and
  // set as `data-theme` on <html>, which the script in Base.astro restores
  // before the first paint of every page. The browser's own bars follow it
  // through the two `theme-color` metas.
  {
    const systemCiemny = window.matchMedia("(prefers-color-scheme: dark)");
    const ciemny = () => {
      const wybrany = doc.getAttribute("data-theme");
      return wybrany ? wybrany === "dark" : systemCiemny.matches;
    };
    const pokaz = () => {
      for (const b of motywy) b.setAttribute("aria-pressed", String(ciemny()));
    };
    pokaz();
    systemCiemny.addEventListener("change", pokaz);
    const przelacz = () => {
      const nowy = ciemny() ? "light" : "dark";
      doc.setAttribute("data-theme", nowy);
      try {
        localStorage.setItem("motyw", nowy);
      } catch {
        // Storage blocked (a private window): the choice holds for this page.
      }
      // The page's colour, as the theme now paints it, for both metas.
      const kolor = getComputedStyle(doc).getPropertyValue("--color-page").trim();
      for (const meta of document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')) meta.content = kolor;
      pokaz();
    };
    for (const b of motywy) b.addEventListener("click", przelacz);
  }

  // `--header-height` is the pinned row's height: same-page links and the
  // drawer sit below it. It changes with the window as lines wrap. Where the
  // header is not pinned (below `lg`, or on a low window, global.css) it
  // scrolls away and the height is 0; holding it at the top while the drawer
  // is open does not count. The observer reports the first size itself,
  // after the page's first layout; reading it here, mid-parse, would force
  // one more.
  const header = surface?.closest<HTMLElement>(".site-header");
  const measure = () => {
    if (!surface || !header) return;
    const pinned = getComputedStyle(header).position === "sticky" && !menu?.open;
    doc.style.setProperty("--header-height", pinned ? `${surface.offsetHeight}px` : "0px");
  };
  if (surface) {
    // On the next frame: set straight from the observer, the height resized
    // the page under other observers (ruch.ts) within the same frame, which
    // WebKit reports as a ResizeObserver loop.
    new ResizeObserver(() => requestAnimationFrame(measure)).observe(surface);
    // Turning a phone can pin or unpin the header without the row changing size.
    window.addEventListener("resize", measure);
  }

  if (menu && backdrop && open && surface) {
    const close = () => menu.open && menu.close();
    // The page behind the drawer is inert while it is open, so the Tab key
    // stays inside; the header row above stays live.
    const behind = [...document.querySelectorAll<HTMLElement>("main, footer")];

    // The drawer starts under the header row. An open drawer holds the row
    // at the top of the window (global.css), so it is measured after the
    // drawer opens; a turned phone changes the row, so again on resize.
    const place = () => {
      const top = Math.max(0, surface.getBoundingClientRect().bottom);
      menu.style.setProperty("--drawer-top", `${top}px`);
      backdrop.style.setProperty("--drawer-top", `${top}px`);
    };
    window.addEventListener("resize", () => menu.open && place());

    open.addEventListener("click", () => {
      if (menu.open) {
        close();
        return;
      }
      backdrop.hidden = false;
      menu.show();
      place();
      for (const el of behind) el.inert = true;
      doc.style.overflow = "hidden";
      open.setAttribute("aria-expanded", "true");
      // The drawer is fixed under the pinned row: focusing it must not
      // scroll the page behind it.
      menu.focus({ preventScroll: true });
    });
    menu.addEventListener("close", () => {
      backdrop.hidden = true;
      for (const el of behind) el.inert = false;
      doc.style.overflow = "";
      open.setAttribute("aria-expanded", "false");
      // The window may have grown past `lg` while the drawer was open.
      measure();
      // Not when the drawer closed because the window grew past `lg` and
      // the button went with it.
      if (open.offsetParent !== null) open.focus({ preventScroll: true });
    });

    backdrop.addEventListener("click", close);
    window.matchMedia("(min-width: 64rem)").addEventListener("change", (e) => e.matches && close());
    document.addEventListener("keydown", (e) => e.key === "Escape" && close());

    // A finger swipe to the left closes the drawer. A mostly vertical move is
    // a scroll, and a mouse drag is a text selection; neither counts.
    let start: { x: number; y: number } | null = null;
    for (const el of [menu, backdrop]) {
      el.addEventListener("pointerdown", (e) => {
        start = e.pointerType === "touch" ? { x: e.clientX, y: e.clientY } : null;
      });
      el.addEventListener("pointerup", (e) => {
        if (start) {
          const dx = start.x - e.clientX;
          const dy = Math.abs(start.y - e.clientY);
          if (dx > 40 && dx > dy) close();
        }
        start = null;
      });
      el.addEventListener("pointercancel", () => (start = null));
    }
  }
</script>
