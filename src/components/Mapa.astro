---
/**
 * A Leaflet map with OpenStreetMap tiles: no API key, no fee, no cookies.
 * Leaflet is bundled with the site, not loaded from a CDN; only the map
 * tiles come from tile.openstreetmap.org (allowed in `public/_headers`).
 *
 * The pins are drawn in CSS (`divIcon`). Leaflet's default pin is a PNG whose
 * path breaks once the build moves it, so it is never used.
 *
 * The map is decoration on top of the facts: every page that shows one also
 * lists the same places as text, which is what works without JavaScript.
 */
import "leaflet/dist/leaflet.css";
import type { Miejsce } from "../data/miejsca";
import { miejsceHref } from "../data/miejsca";

interface Props {
  miejsca: readonly Miejsce[];
  /** Zoom when there is one place; with several the map fits them all. */
  zoom?: number;
  /** What the map shows, for screen readers. */
  label: string;
  class?: string;
}

const { miejsca, zoom = 12, label, class: className } = Astro.props;

const pins = miejsca.map((m) => ({
  nazwa: m.nazwa,
  rodzaj: m.rodzaj,
  lat: m.geo.lat,
  lng: m.geo.lng,
  adres: m.adres ?? "",
  href: miejsceHref(m),
}));
---

<div
  class:list={["mapa", className]}
  data-mapa={JSON.stringify(pins)}
  data-zoom={zoom}
  role="region"
  aria-label={label}
>
</div>

<script>
  import L from "leaflet";

  interface Pin {
    nazwa: string;
    rodzaj: "punkt" | "dostawa";
    lat: number;
    lng: number;
    adres: string;
    href: string;
  }

  for (const el of document.querySelectorAll<HTMLElement>("[data-mapa]")) {
    const pins: Pin[] = JSON.parse(el.dataset.mapa ?? "[]");
    if (pins.length === 0) continue;

    // Scroll-wheel zoom off: a page scrolling past the map should not get
    // caught by it. The +/- buttons and pinch still zoom.
    const map = L.map(el, { scrollWheelZoom: false });
    L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 18,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(map);

    for (const pin of pins) {
      const big = pin.rodzaj === "punkt";
      const icon = L.divIcon({
        className: "",
        html: `<div class="pin${big ? " pin-punkt" : ""}"></div>`,
        iconSize: big ? [28, 28] : [24, 24],
        iconAnchor: big ? [4, 30] : [4, 26],
        popupAnchor: [10, -26],
      });

      // Built from DOM nodes, not an HTML string, so a name with an odd
      // character cannot break the markup.
      const popup = document.createElement("div");
      const name = document.createElement("strong");
      name.textContent = pin.nazwa;
      popup.append(name);
      if (pin.adres) popup.append(document.createElement("br"), pin.adres);
      const link = document.createElement("a");
      link.href = pin.href;
      link.textContent = big ? "Punkt sprzedaży i dostawa" : "Dostawa i ceny";
      popup.append(document.createElement("br"), link);

      L.marker([pin.lat, pin.lng], { icon, title: pin.nazwa, alt: pin.nazwa }).addTo(map).bindPopup(popup);
    }

    if (pins.length === 1) {
      map.setView([pins[0]!.lat, pins[0]!.lng], Number(el.dataset.zoom));
    } else {
      map.fitBounds(L.latLngBounds(pins.map((p) => [p.lat, p.lng])), { padding: [32, 32] });
    }
  }
</script>
