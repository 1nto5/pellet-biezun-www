---
/**
 * A Leaflet map with OpenStreetMap tiles: no API key, no fee, no cookies.
 * Leaflet is bundled with the site, not loaded from a CDN; only the map
 * tiles come from tile.openstreetmap.org (allowed in `public/_headers`).
 * The drawing itself is in `mapa.ts`, loaded only when the map comes near
 * the screen.
 *
 * The warehouse is always on the map, as a pin drawn in CSS (`divIcon`).
 * Leaflet's default pin is a PNG whose path breaks once the build moves it,
 * so it is never used. Towns are small dots (`circleMarker`), the page's own
 * town larger; their colours come from the tokens in `global.css`. A dot
 * shows its town's name under the pointer and, clicked, a popup with a link
 * to the order form.
 *
 * With `trasy` the map also draws the road from the warehouse to the chosen
 * town and can be steered from outside, through events on its element:
 * `mapa:wybierz` in, `mapa:wybrano` and `mapa:gotowa` out (see `mapa.ts`).
 *
 * The map is decoration on top of the facts: every page that shows one also
 * lists the same places as text, which is what works without JavaScript.
 * Without JavaScript, or when Leaflet fails to load, the box goes rather than
 * say "Ładowanie mapy…" for ever.
 */
import { firma, addressLine } from "../data/firma";
import type { Miejsce } from "../data/miejsca";
import { miejsceHref } from "../data/miejsca";
import { strony } from "../data/nav";
import { maPodstrone, pelnaNazwa } from "../lib/miejsce";
import type { DaneMapy } from "./mapa";

interface Props {
  /** Towns drawn as dots. None: the map shows the warehouse alone. */
  miejsca?: readonly Miejsce[];
  /** One town drawn bigger, e.g. the town of a local page. */
  wyroznione?: Miejsce;
  /** Zoom when the map shows the warehouse alone; otherwise it fits everything drawn. */
  zoom?: number;
  /** Draw the road to the chosen town and listen to the page (the distribution map only). */
  trasy?: boolean;
  /** What the map shows, for screen readers. */
  label: string;
  class?: string;
}

const { miejsca = [], wyroznione, zoom = 13, trasy = false, label, class: className } = Astro.props;

const dane: DaneMapy = {
  magazyn: {
    nazwa: firma.name,
    adres: addressLine(),
    tel: firma.phone.label,
    telHref: firma.phone.href,
    lat: firma.geo.lat,
    lng: firma.geo.lng,
  },
  miejsca: miejsca.map((m) => {
    const wlasne = wyroznione !== undefined && m.nazwa === wyroznione.nazwa && m.geo.lat === wyroznione.geo.lat;
    return {
      klucz: m.nazwa,
      nazwa: pelnaNazwa(m),
      lat: m.geo.lat,
      lng: m.geo.lng,
      // A town's own page does not link to itself from its dot.
      href: maPodstrone(m) && !wlasne ? miejsceHref(m) : null,
      wyroznione: wlasne,
    };
  }),
  zamow: strony.zamowienie.href,
};
---

<section class:list={["mapa", className]} data-mapa={JSON.stringify(dane)} data-zoom={zoom} data-trasy={trasy || undefined} aria-label={label}></section>

<script>
  // Leaflet (about 150 KB) and its stylesheet load only when a map comes
  // within half a screen of view. The connection to the tile server opens at
  // the same moment, so the first tiles do not wait for it after Leaflet.
  let polaczono = false;
  const obserwator = new IntersectionObserver(
    (wpisy) => {
      for (const wpis of wpisy) {
        if (!wpis.isIntersecting) continue;
        obserwator.unobserve(wpis.target);
        if (!polaczono) {
          polaczono = true;
          document.head.append(Object.assign(document.createElement("link"), { rel: "preconnect", href: "https://tile.openstreetmap.org" }));
        }
        const el = wpis.target as HTMLElement;
        import("./mapa")
          .then(({ narysujMape }) => narysujMape(el))
          .catch(() => {
            el.hidden = true;
          });
      }
    },
    { rootMargin: "50% 0px" },
  );
  for (const el of document.querySelectorAll<HTMLElement>("[data-mapa]")) obserwator.observe(el);
</script>

<style>
  /* Without JavaScript nothing draws the map; the places are listed as text. */
  :global(html:not([data-js])) .mapa {
    display: none;
  }
</style>
