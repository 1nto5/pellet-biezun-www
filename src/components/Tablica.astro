---
/**
 * A green direction board for one town, linking its page, with the town's
 * name. `.tablica` in global.css.
 */
import NazwaMiejsca from "./NazwaMiejsca.astro";
import type { Miejsce } from "../data/miejsca";

interface Props {
  miejsce: Miejsce;
  href: string;
}

const { miejsce, href } = Astro.props;
---

<a href={href} class="sign tablica">
  <span class="tablica-nazwa"><NazwaMiejsca miejsce={miejsce} /></span>
</a>
