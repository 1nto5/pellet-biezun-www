---
/**
 * Where the contact form sends the reader once the message has gone out
 * (`functions/api/kontakt.ts`). Not a page to find in a search engine:
 * `noindex`, and left out of the sitemap in astro.config.mjs.
 */
import Base from "../../layouts/Base.astro";
import PageShell from "../../components/PageShell.astro";
import PageHeader from "../../components/PageHeader.astro";
import { firma } from "../../data/firma";
import { strony } from "../../data/nav";
---

<Base title="Dziękujemy za wiadomość" description="Wiadomość została wysłana." noindex>
  <PageShell>
    <PageHeader slot="header" title="Dziękujemy za wiadomość" lead="Dostaliśmy Twoją wiadomość i odpowiemy na podany adres e-mail." />
    <div class="max-w-prose space-y-4">
      <p>
        Sprawa jest pilna? Zadzwoń:
        <a href={firma.phone.href} class="link-strong">{firma.phone.label}</a>.
      </p>
      <p>
        <a href={strony.home.href} class="link-strong">Wróć na stronę główną</a>
      </p>
    </div>
  </PageShell>
</Base>
