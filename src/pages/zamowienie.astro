---
import Base from "../layouts/Base.astro";
import PageShell from "../components/PageShell.astro";
import PageHeader from "../components/PageHeader.astro";
import Formularz from "../components/Formularz.astro";
import { firma } from "../data/firma";
import { produkty, cenaLabel } from "../data/oferta";
import { miejsca } from "../data/miejsca";
---

<Base
  title="Zamówienie"
  description="Zamów pellet drzewny z dostawą. Wypełnij formularz, oddzwonimy z potwierdzeniem ceny i terminu. Bez płatności online."
>
  <PageShell>
    <PageHeader
      slot="header"
      title="Zamów pellet"
      lead="Wypełnij formularz, a oddzwonimy, żeby potwierdzić cenę i termin dostawy. Strona nie pobiera płatności."
    />

    <div class="grid gap-12 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
      <Formularz action="/api/zamowienie" submitLabel="Wyślij zamówienie" purpose="przyjęcia i realizacji zamówienia">
        <fieldset class="space-y-5">
          <legend class="mb-4 text-3xl">Co zamawiasz</legend>
          <div class="grid gap-5 sm:grid-cols-2">
            <div class="field">
              <label for="produkt">Produkt <span class="req">*</span></label>
              <select id="produkt" name="produkt" class="input" required>
                {produkty.map((p) => <option value={p.id}>{p.nazwa} ({cenaLabel(p)})</option>)}
              </select>
            </div>
            <div class="field">
              <label for="ilosc">Ilość <span class="req">*</span></label>
              <input id="ilosc" name="ilosc" type="text" class="input" required aria-describedby="ilosc-hint" />
              <span id="ilosc-hint" class="hint">Np. „2 palety”.</span>
            </div>
          </div>
          <div class="field sm:max-w-xs">
            <label for="termin">Preferowany termin dostawy</label>
            <input id="termin" name="termin" type="date" class="input" aria-describedby="termin-hint" />
            <span id="termin-hint" class="hint">Postaramy się dopasować, potwierdzimy telefonicznie.</span>
          </div>
        </fieldset>

        <fieldset class="space-y-5">
          <legend class="mb-4 text-3xl">Adres dostawy</legend>
          <div class="field">
            <label for="ulica">Ulica i numer <span class="req">*</span></label>
            <input id="ulica" name="ulica" type="text" class="input" autocomplete="street-address" required />
          </div>
          <div class="grid gap-5 sm:grid-cols-[10rem_1fr]">
            <div class="field">
              <label for="kod">Kod pocztowy <span class="req">*</span></label>
              <input
                id="kod"
                name="kod"
                type="text"
                class="input"
                inputmode="numeric"
                autocomplete="postal-code"
                pattern="[0-9]{2}-[0-9]{3}"
                placeholder="09-320"
                title="Kod w formacie 00-000"
                required
              />
            </div>
            <div class="field">
              <label for="miejscowosc">Miejscowość <span class="req">*</span></label>
              <input
                id="miejscowosc"
                name="miejscowosc"
                type="text"
                class="input"
                autocomplete="address-level2"
                list="miejscowosci"
                required
              />
              <datalist id="miejscowosci">
                {miejsca.map((m) => <option value={m.nazwa} />)}
              </datalist>
            </div>
          </div>
        </fieldset>

        <fieldset class="space-y-5">
          <legend class="mb-4 text-3xl">Dane kontaktowe</legend>
          <div class="field">
            <label for="imie">Imię i nazwisko <span class="req">*</span></label>
            <input id="imie" name="imie" type="text" class="input" autocomplete="name" required />
          </div>
          <div class="grid gap-5 sm:grid-cols-2">
            <div class="field">
              <label for="telefon">Telefon <span class="req">*</span></label>
              <input id="telefon" name="telefon" type="tel" class="input" autocomplete="tel" required />
            </div>
            <div class="field">
              <label for="email">E-mail <span class="req">*</span></label>
              <input id="email" name="email" type="email" class="input" autocomplete="email" required aria-describedby="email-hint" />
              <span id="email-hint" class="hint">Wyślemy na niego potwierdzenie zamówienia.</span>
            </div>
          </div>
          <div class="field">
            <label for="uwagi">Uwagi</label>
            <textarea id="uwagi" name="uwagi" class="input" rows="4" aria-describedby="uwagi-hint"></textarea>
            <span id="uwagi-hint" class="hint">Np. dojazd, godziny, w których ktoś jest w domu, faktura na firmę.</span>
          </div>
        </fieldset>
      </Formularz>

      <aside class="kroki-ramka space-y-4 self-start lg:sticky" aria-labelledby="jak-to-dziala">
        <h2 id="jak-to-dziala" class="text-2xl">Jak to działa</h2>
        <ol class="kroki">
          <li>Wysyłasz formularz, na e-mail dostajesz potwierdzenie przyjęcia.</li>
          <li>Oddzwaniamy, żeby potwierdzić cenę i termin dostawy.</li>
          <li>Przywozimy pellet i rozładowujemy go windą i elektrycznym wózkiem paletowym.</li>
        </ol>
        <p>
          Wolisz zadzwonić? <a href={firma.phone.href} class="link-strong">{firma.phone.label}</a>
        </p>
      </aside>
    </div>
  </PageShell>
</Base>

<style>
  /* The three steps, in order, on a white panel with the banner's yellow
     frame; it stays in view beside the long form. */
  .kroki-ramka {
    top: calc(var(--header-height) + 1.5rem);
    padding: 1.5rem 1.5rem 1.25rem;
    border: 0.3rem solid var(--color-yellow);
    border-radius: 1rem;
  }
  .kroki {
    display: grid;
    gap: 0.75rem;
    padding-left: 1.4rem;
    list-style: decimal;
  }
  .kroki li::marker {
    font-weight: 900;
  }
</style>
