---
import Base from "../layouts/Base.astro";
import PageShell from "../components/PageShell.astro";
import PageHeader from "../components/PageHeader.astro";
import TablicaWjazdowa from "../components/TablicaWjazdowa.astro";
import { faq } from "../data/faq";
import { firma } from "../data/firma";
import { strony } from "../data/nav";

const faqPage = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<Base
  title="Częste pytania o pellet i dostawę"
  description="Odpowiedzi na częste pytania o pellet: palety, koszt dostawy, rozładunek, przechowywanie, certyfikaty, odbiór z magazynu."
  jsonLd={[faqPage]}
>
  <PageShell>
    <PageHeader slot="header" title="Częste pytania" />

    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_22rem]">
      <div class="faq max-w-prose" data-ruch-grupa>
        {
          faq.map((item, i) => (
            <details open={i === 0}>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>

      <aside class="rail space-y-5" aria-label="Kontakt">
        <p class="text-lg font-medium">
          Nie ma tu Twojego pytania? Zadzwoń pod <a href={firma.phone.href} class="link-strong">{firma.phone.label}</a> albo
          <a href={strony.kontakt.href}>napisz do nas</a>.
        </p>
        <TablicaWjazdowa />
      </aside>
    </div>
  </PageShell>
</Base>
