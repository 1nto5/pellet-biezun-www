---
import Base from "../layouts/Base.astro";
import PageShell from "../components/PageShell.astro";
import PageHeader from "../components/PageHeader.astro";
import Mapa from "../components/Mapa.astro";
import NazwaMiejsca from "../components/NazwaMiejsca.astro";
import Tablica from "../components/Tablica.astro";
import { firma } from "../data/firma";
import { nazwaWlasna, pelnaNazwa } from "../lib/miejsce";
import { zloz } from "../lib/zloz";
import {
  ZASADA_DOSTAWY,
  miejsca,
  podstronyPoOdleglosci,
  wojewodztwa,
  miejsceHref,
  odlegloscKm,
} from "../data/miejsca";

// Every town by voivodeship, nearest first.
const grupy = wojewodztwa
  .map((w) => ({
    wojewodztwo: w,
    miejsca: miejsca.filter((m) => m.wojewodztwo === w).sort((a, b) => odlegloscKm(a) - odlegloscKm(b)),
  }))
  .filter((g) => g.miejsca.length > 0);

// Some villages of the place index (src/data/indeks) are named exactly like
// one of the towns above: ten are "Kozłowo". The search confirms a town
// named whole without fetching the index, so it is told here which names
// need the index after all. The files are read only now, while the page is
// built; the page gets the short list of folded names.
const indeks = import.meta.glob<{ miejsca: [string, ...unknown[]][] }>("../data/indeks/*.json", { eager: true, import: "default" });
const wIndeksie = new Set(Object.values(indeks).flatMap((plik) => plik.miejsca.map(([nazwa]) => zloz(nazwa))));
const dublety = [...new Set(miejsca.flatMap((m) => [nazwaWlasna(m), pelnaNazwa(m)].map(zloz)))].filter((nazwa) => wIndeksie.has(nazwa));
---

<Base
  title="Mapa dystrybucji: dokąd dowozimy pellet"
  description={`Dokąd dowozimy pellet z magazynu we Władysławowie pod Bieżuniem: ${miejsca.length} miejscowości w ${wojewodztwa.length} województwach. ${ZASADA_DOSTAWY}`}
>
  <PageShell>
    <PageHeader
      slot="header"
      title="Mapa dystrybucji"
      lead={`Nasz magazyn jest we Władysławowie pod Bieżuniem. ${ZASADA_DOSTAWY}`}
    />

    {/* Beside the map, never in it: Leaflet draws into an empty box. Only the
        page script makes it work, so without scripts it is not shown. */}
    <div class="szukaj mb-5" data-szukaj data-tel={firma.phone.label} data-tel-href={firma.phone.href} data-zasada={ZASADA_DOSTAWY} data-dublety={dublety.join("|")}>
      <form role="search" class="szukaj-form">
        <div class="field">
          <label for="szukaj-miejsce">Sprawdź swoją miejscowość</label>
          <input
            id="szukaj-miejsce"
            type="text"
            class="input"
            placeholder="np. Mława"
            autocomplete="off"
            autocapitalize="words"
            enterkeyhint="search"
            list="szukaj-miejscowosci"
            maxlength="100"
          />
          <datalist id="szukaj-miejscowosci">
            {miejsca.map((m) => <option value={nazwaWlasna(m)} />)}
          </datalist>
        </div>
        <button type="submit" class="btn btn-primary">Pokaż na mapie</button>
      </form>
      <p class="szukaj-wynik" aria-live="polite" data-wynik data-podpowiedz>Możesz też wybrać miejscowość na mapie.</p>
    </div>

    <Mapa miejsca={miejsca} trasy class="mapa-dystrybucja" label="Mapa: magazyn i miejscowości, do których dowozimy" />

    <section class="mt-12" aria-labelledby="podstrony">
      <h2 id="podstrony" class="text-3xl">Dostawa w Twojej okolicy</h2>
      <ul role="list" class="tablice mt-6" data-ruch-grupa="tablica">
        {
          podstronyPoOdleglosci.map((m) => (
            <li>
              <Tablica miejsce={m} href={miejsceHref(m)} />
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12" aria-labelledby="wszystkie">
      <h2 id="wszystkie" class="text-3xl">Wszystkie miejscowości</h2>
      <p class="tylko-js mt-2 text-ink-soft">Wybierz miejscowość, żeby zobaczyć ją na mapie.</p>
      <div class="miejscowosci mt-6">
        {
          grupy.map((g, i) => (
            <section aria-labelledby={`wojewodztwo-${i}`}>
              <h3 id={`wojewodztwo-${i}`} class="text-xl">Województwo {g.wojewodztwo}</h3>
              <ul role="list" class="mt-3">
                {g.miejsca.map((m) => (
                  <li class="border-b border-line py-1" data-miejsce={m.nazwa}>
                    <NazwaMiejsca miejsce={m} />
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </section>

    <p class="mt-12 max-w-prose text-ink-soft">
      Lista i kropki na mapie to tylko część miejscowości: dowozimy też do okolicznych wsi. Masz
      pytanie o dostawę do siebie? Zadzwoń pod <a href={firma.phone.href} class="link-strong">{firma.phone.label}</a>, ustalimy
      szczegóły.
    </p>
  </PageShell>
</Base>

<script>
  import type { DaneMapy, PunktMapy, WyborMapy } from "../components/mapa";
  import { zloz } from "../lib/zloz";
  import { etykietyZIndeksu } from "../lib/etykieta";

  // The search field and the town list steer the map through an event on
  // its element (see mapa.ts): `mapa:wybierz` chooses a town, and the map
  // answers with `mapa:wybrano`, whatever chose the town.
  const mapa = document.querySelector<HTMLElement>(".mapa[data-trasy]");
  const szukaj = document.querySelector<HTMLElement>("[data-szukaj]");
  const pole = szukaj?.querySelector<HTMLInputElement>("input");
  const wynik = szukaj?.querySelector<HTMLElement>("[data-wynik]");

  if (mapa && szukaj && pole && wynik) {
    // The towns as the map has them: `klucz` is the bare name, `nazwa` the
    // name with its note ("Nowe Miasto k. Płońska").
    type Miejsce = DaneMapy["miejsca"][number];
    const dane = JSON.parse(mapa.dataset.mapa ?? "{}") as DaneMapy;
    const miejsca = dane.miejsca;
    // The line under the field starts as a hint, small and muted
    // (`data-podpowiedz`), gives way to an answer and comes back when the
    // answer no longer holds.
    const tekstPodpowiedzi = wynik.textContent ?? "";
    function odpowiedz(...tresc: (string | Node)[]): void {
      wynik!.replaceChildren(...tresc);
      wynik!.removeAttribute("data-podpowiedz");
    }
    function podpowiedz(): void {
      wynik!.textContent = tekstPodpowiedzi;
      wynik!.setAttribute("data-podpowiedz", "");
    }
    const bezRuchu = window.matchMedia("(prefers-reduced-motion: reduce)");

    // A town's name without how often we go there: "Mikołajki (czasem)" is
    // "Mikołajki" in the field, "Lidzbark Welski" stays whole.
    const wlasna = (m: Miejsce) => m.nazwa.replace(/ \([^)]*\)$/, "");
    const zlozone = miejsca.map((m) => ({ m, cale: [zloz(wlasna(m)), zloz(m.nazwa)], nazwy: [zloz(m.klucz), zloz(wlasna(m))] }));

    /**
     * The whole name first, then names that start with the text, then names
     * that hold it; `poziom` says which of the three it was. Two towns are
     * "Lidzbark" and two "Nowe Miasto", so only a whole name with its second
     * part counts as the whole name: "Lidzbark" alone finds both, and the
     * reader picks. A name typed as the page prints it, "Mikołajki (czasem)",
     * is a whole name too.
     */
    function pasujace(szukane: string): { poziom: number; znalezione: Miejsce[] } {
      const proby: ((z: (typeof zlozone)[number]) => boolean)[] = [
        (z) => z.cale.includes(szukane),
        (z) => z.nazwy.some((n) => n.startsWith(szukane)),
        (z) => z.nazwy.some((n) => n.includes(szukane)),
      ];
      for (const [poziom, pasuje] of proby.entries()) {
        const znalezione = zlozone.filter(pasuje);
        if (znalezione.length > 0) return { poziom, znalezione: znalezione.map((z) => z.m) };
      }
      return { poziom: 0, znalezione: [] };
    }

    // The places we drive to that have no dot on the map: one file for each
    // first letter of the folded name (src/data/indeks), fetched when a
    // search needs it. `gminy` are [gmina, powiat], `miejsca` are
    // [name, index into gminy, lat, lng]. A browser does not fetch a failed
    // module again: after a failure that letter finds no such places until
    // the page is reloaded, and the search answers as it did without them.
    interface Indeks {
      gminy: [string, string][];
      miejsca: [string, number, number, number][];
    }
    interface Wpis {
      nazwa: string;
      gmina: string;
      powiat: string;
      lat: number;
      lng: number;
    }
    const pliki = import.meta.glob<Indeks>("../data/indeks/*.json", { import: "default" });
    async function zIndeksu(szukane: string, poczatki: boolean): Promise<Wpis[]> {
      const plik = pliki[`../data/indeks/${szukane[0]}.json`];
      const indeks = await plik?.().catch(() => undefined);
      if (!indeks) return [];
      const wpisy = (pasuje: (nazwa: string) => boolean): Wpis[] =>
        indeks.miejsca
          .filter(([nazwa]) => pasuje(zloz(nazwa)))
          .map(([nazwa, g, lat, lng]) => ({ nazwa, gmina: indeks.gminy[g]?.[0] ?? "", powiat: indeks.gminy[g]?.[1] ?? "", lat, lng }));
      // The name itself. Names that only start with the text count when
      // `poczatki` allows it and from four letters up: fewer would match half
      // of the file.
      const cale = wpisy((nazwa) => nazwa === szukane);
      if (cale.length > 0 || !poczatki || szukane.replace(/ /g, "").length < 4) return cale;
      return wpisy((nazwa) => nazwa.startsWith(szukane));
    }

    // The map is drawn only when it comes near the screen; a town picked
    // before that waits for it. Only the last pick counts.
    // `null` chooses no town: a search for a place that has no dot takes the
    // last one's road off the map. `punkt` is a place from the index: the map
    // gives it a dot for as long as it is chosen.
    let czeka: WyborMapy | undefined;
    function wybierz(klucz: string | null, punkt?: PunktMapy): void {
      const wybor: WyborMapy = { klucz, punkt };
      if ("gotowa" in mapa!.dataset) mapa!.dispatchEvent(new CustomEvent("mapa:wybierz", { detail: wybor }));
      else czeka = wybor;
    }
    mapa.addEventListener(
      "mapa:gotowa",
      () => {
        if (czeka) wybierz(czeka.klucz, czeka.punkt);
        czeka = undefined;
      },
      { once: true },
    );

    // The town the line under the field speaks of, by its key on the map.
    // When the map says another town is chosen, or none, the line no longer
    // holds and goes.
    let potwierdzona: string | undefined;
    // The town's name as this script last wrote it into the field.
    let wPolu = "";
    /**
     * What a search can end at: a town with a dot (`m`) or a place from the
     * index (`punkt`), under the name the reader picks it by.
     */
    interface Kandydat {
      etykieta: string;
      m?: Miejsce;
      punkt?: PunktMapy | undefined;
    }
    // Both are set before the map is told: it answers with `mapa:wybrano`
    // at once, and the handler below compares against them.
    function potwierdz({ etykieta, m, punkt }: Kandydat): void {
      potwierdzona = m?.klucz ?? punkt?.klucz;
      pole!.value = wPolu = m ? wlasna(m) : (punkt?.wlasna ?? "");
      odpowiedz(`Tak, dowozimy do miejscowości ${etykieta}.`);
      wybierz(potwierdzona ?? null, punkt);
      // The whole map, with the answer above it, comes into the window if a
      // part of it was below the edge.
      mapa!.scrollIntoView({ behavior: bezRuchu.matches ? "instant" : "smooth", block: "nearest" });
    }

    /**
     * The places of the index as candidates: "Szymany (gm. Szczytno)", with
     * the powiat added where the label could be taken for another place
     * (`etykietyZIndeksu`). The key is made up for the map; no town's name
     * starts with "@".
     */
    const nazwyZListy = new Set(miejsca.flatMap((m) => [zloz(m.klucz), zloz(wlasna(m))]));
    function kandydaciZIndeksu(wpisy: Wpis[]): Kandydat[] {
      const etykiety = etykietyZIndeksu(wpisy, nazwyZListy);
      return wpisy.map((w, i) => {
        const etykieta = etykiety[i]!;
        return { etykieta, punkt: { klucz: `@${w.lat},${w.lng},${w.nazwa}`, nazwa: etykieta, wlasna: w.nazwa, gmina: w.gmina, lat: w.lat, lng: w.lng } };
      });
    }

    // The towns' names, folded, that some place of the index bears too
    // (worked out when the page is built).
    const dublety = new Set((szukaj.dataset.dublety ?? "").split("|"));
    // A candidate picked from the answer line, by its button or the list's.
    // The button is gone at once and the page scrolls to the map, so a
    // second quick tap would fall on whatever comes under the finger, the
    // popup's link included: clicks are dropped for half a second.
    const polknij = (e: Event) => {
      e.stopPropagation();
      e.preventDefault();
    };
    function potwierdzZLinii(k: Kandydat): void {
      potwierdz(k);
      // The field takes the keyboard without pulling the page back to
      // itself: the page is on its way to the map.
      pole!.focus({ preventScroll: true });
      document.addEventListener("click", polknij, true);
      window.setTimeout(() => document.removeEventListener("click", polknij, true), 500);
    }

    // Only the last search counts: an answer that waited for its index file
    // must not overwrite a newer one, nor a town picked meanwhile on the map
    // or from the list (the counter also goes up there).
    let szukanie = 0;
    szukaj.querySelector("form")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const wpisane = pole.value.trim();
      // The field still holds the confirmed place as this script wrote it:
      // the place stays chosen, the reader only gets the map into view.
      if (potwierdzona !== undefined && wpisane === wPolu) {
        mapa.scrollIntoView({ behavior: bezRuchu.matches ? "instant" : "smooth", block: "nearest" });
        return;
      }
      const to = ++szukanie;
      potwierdzona = undefined;
      if (!wpisane) {
        podpowiedz();
        pole.focus();
        return;
      }
      const szukane = zloz(wpisane);
      const { poziom, znalezione } = pasujace(szukane);
      let kandydaci: Kandydat[] = znalezione.map((m) => ({ etykieta: m.nazwa, m }));
      let zIndeksem = false;
      // One town with a dot, named whole, needs no index, unless places of
      // the index share its name: those are offered after it. Otherwise the
      // places of the index come after the towns with dots, and beside them
      // a town counts only if its name is, or starts with, the text.
      if (!(poziom === 0 && znalezione.length === 1 && !dublety.has(szukane))) {
        // "Lidzbark" already asks which of the two towns: names from the
        // index that merely start so ("Lidzbark-Nadleśnictwo") stay out.
        const wpisy = await zIndeksu(szukane, poziom === 2 || znalezione.length === 0);
        if (to !== szukanie) return;
        if (wpisy.length > 0) {
          zIndeksem = true;
          kandydaci = [...(poziom < 2 ? kandydaci : []), ...kandydaciZIndeksu(wpisy)];
        }
      }
      const [jedyny] = kandydaci;
      if (jedyny && kandydaci.length === 1) {
        potwierdz(jedyny);
      } else if (kandydaci.length > 6 && zIndeksem) {
        // Too many for buttons: a list to choose from, in the order of the
        // alphabet. The sentence speaks of one name only when every name on
        // the list is the same, and asks for the gmina only when every
        // place has one in its label (a town with a dot has none).
        const jednaNazwa = kandydaci.every((k) => zloz(k.m ? wlasna(k.m) : (k.punkt?.wlasna ?? "")) === szukane);
        const sameGminy = kandydaci.every((k) => k.punkt !== undefined);
        const lista = Object.assign(document.createElement("select"), { className: "input" });
        lista.setAttribute("aria-label", jednaNazwa && sameGminy ? "Gmina" : "Miejscowość");
        lista.append(Object.assign(document.createElement("option"), { value: "", textContent: "wybierz z listy", disabled: true, selected: true }));
        const poAlfabecie = [...kandydaci].sort((a, b) => a.etykieta.localeCompare(b.etykieta, "pl"));
        // Names from the index go in as text, like the towns' below.
        lista.append(...poAlfabecie.map((k, i) => Object.assign(document.createElement("option"), { value: String(i), textContent: k.etykieta })));
        // Choosing an option confirms nothing by itself: with a keyboard
        // every letter or arrow key chooses one. The button beside the list
        // confirms, and so does Enter in the list; neither while the prompt
        // is still the chosen option.
        const pokaz = Object.assign(document.createElement("button"), { type: "button", className: "btn btn-secondary btn-sm", textContent: "Pokaż" });
        const potwierdzWybrana = () => {
          const wybrany = lista.value === "" ? undefined : poAlfabecie[Number(lista.value)];
          if (wybrany) potwierdzZLinii(wybrany);
        };
        pokaz.addEventListener("click", potwierdzWybrana);
        lista.addEventListener("keydown", (klawisz) => {
          if (klawisz.key !== "Enter") return;
          klawisz.preventDefault();
          potwierdzWybrana();
        });
        const wybor = Object.assign(document.createElement("span"), { className: "szukaj-wybor" });
        wybor.append(lista, pokaz);
        odpowiedz(
          `Miejscowości o ${jednaNazwa ? "tej nazwie" : "nazwie zaczynającej się tak"} jest w zasięgu kilka. ${jednaNazwa && sameGminy ? "Wybierz gminę" : "Wybierz swoją"}: `,
          wybor,
        );
        wybierz(null);
      } else if (kandydaci.length > 6) {
        odpowiedz(`Pasujących miejscowości: ${kandydaci.length}. Wpisz więcej liter.`);
        wybierz(null);
      } else if (kandydaci.length > 1) {
        // The names come from our own list, but they too go in as text.
        const przyciski = kandydaci.map((k) => {
          const przycisk = Object.assign(document.createElement("button"), { type: "button", className: "btn btn-secondary btn-sm", textContent: k.etykieta });
          przycisk.addEventListener("click", () => potwierdzZLinii(k));
          return przycisk;
        });
        odpowiedz("Która miejscowość? ", ...przyciski);
        wybierz(null);
      } else {
        // The dots and the index are only some of the places we drive to, so
        // a name found in neither is a yes as well, under the delivery rule.
        // What the reader typed goes in as text, never as markup, and on to
        // the order form.
        const zamow = Object.assign(document.createElement("a"), {
          href: `${dane.zamow}?miejscowosc=${encodeURIComponent(wpisane)}`,
          textContent: "Zamów dostawę",
          className: "link-strong",
        });
        const tel = Object.assign(document.createElement("a"), { href: szukaj.dataset.telHref ?? "", textContent: szukaj.dataset.tel ?? "", className: "link-strong" });
        odpowiedz(
          `Tak, dowozimy też do miejscowości „${wpisane}”. Na mapie zaznaczyliśmy tylko część miejscowości. ${szukaj.dataset.zasada ?? ""} `,
          zamow,
          " lub zadzwoń pod ",
          tel,
          ".",
        );
        wybierz(null);
      }
    });

    // Every town of the list becomes a button that shows it on the map.
    // Without scripts the list stays plain text.
    const pozycje = [...document.querySelectorAll<HTMLElement>("[data-miejsce]")];
    for (const pozycja of pozycje) {
      const przycisk = Object.assign(document.createElement("button"), { type: "button" });
      przycisk.append(...pozycja.childNodes);
      przycisk.addEventListener("click", () => {
        // A search still waiting for its file gives way to this pick, also
        // when the town is the chosen one already and the map says nothing.
        szukanie++;
        wybierz(pozycja.dataset.miejsce!);
        mapa.scrollIntoView({ behavior: bezRuchu.matches ? "instant" : "smooth", block: "center" });
        // The keyboard goes with the reader to the map: the next Tab is in
        // the town's popup, not back in the list, now out of the window.
        mapa.focus({ preventScroll: true });
      });
      pozycja.append(przycisk);
    }

    // Whatever chose the town (the field, the list, a click on a dot), the
    // list marks it and the field names it. When no town is chosen any more,
    // the field is emptied only if it still holds that town's name: what the
    // reader has typed since stays.
    mapa.addEventListener("mapa:wybrano", (e) => {
      const klucz: string | null = (e as CustomEvent).detail.klucz;
      // A search still waiting for its index file is dropped: the reader has
      // chosen another way meanwhile. The search's own choices come after
      // its check of the counter, so they are not touched.
      szukanie++;
      for (const pozycja of pozycje) {
        const przycisk = pozycja.querySelector("button");
        if (pozycja.dataset.miejsce === klucz) przycisk?.setAttribute("aria-current", "true");
        else przycisk?.removeAttribute("aria-current");
      }
      const m = miejsca.find((miejsce) => miejsce.klucz === klucz);
      if (m) pole.value = wPolu = wlasna(m);
      // A place from the index is not among the towns; the search has just
      // written its name into the field, and it stays.
      else if (klucz !== potwierdzona && pole.value === wPolu) pole.value = "";
      // The line under the field goes back to its hint when it speaks of a
      // town that is no longer the chosen one, or of a place without a dot
      // while the reader has picked a town on the map.
      const nieaktualna = potwierdzona !== undefined ? klucz !== potwierdzona : klucz !== null;
      if (nieaktualna) {
        potwierdzona = undefined;
        podpowiedz();
      }
    });
  }
</script>

<style>
  /* The search above the map and the hint over the list work only through
     the page script. */
  :global(html:not([data-js])) :is(.szukaj, .tylko-js) {
    display: none;
  }
  /* On a phone the field and the button stack; from a tablet up they share
     a row, the button level with the field under its label. */
  .szukaj-form {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 48rem) {
    .szukaj-form {
      grid-template-columns: minmax(0, 24rem) auto;
      align-items: end;
      justify-content: start;
    }
  }
  /* The line under the field: a hint, then the answer in its place. An
     answer may be taller than the hint and push the map down, and the map
     comes back up when the reader picks from the answer's own buttons.
     The buttons are made by the script, hence `:global`. */
  .szukaj-wynik {
    max-width: 65ch;
    margin-top: 0.75rem;
    font-weight: 600;
  }
