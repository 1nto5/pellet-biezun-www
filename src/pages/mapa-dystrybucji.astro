---
import Base from "../layouts/Base.astro";
import PageShell from "../components/PageShell.astro";
import PageHeader from "../components/PageHeader.astro";
import Mapa from "../components/Mapa.astro";
import NazwaMiejsca from "../components/NazwaMiejsca.astro";
import Tablica from "../components/Tablica.astro";
import { firma } from "../data/firma";
import {
  DARMOWA_DOSTAWA_KM,
  miejsca,
  grupyPodstron,
  wojewodztwa,
  miejsceHref,
  odlegloscKm,
  wStrefieDarmowej,
} from "../data/miejsca";

// Every town by voivodeship, nearest first.
const grupy = wojewodztwa
  .map((w) => ({
    wojewodztwo: w,
    miejsca: miejsca.filter((m) => m.wojewodztwo === w).sort((a, b) => odlegloscKm(a) - odlegloscKm(b)),
  }))
  .filter((g) => g.miejsca.length > 0);
---

<Base
  title="Mapa dystrybucji"
  description={`Dokąd dowozimy pellet z magazynu we Władysławowie pod Bieżuniem: gratis w promieniu ok. ${DARMOWA_DOSTAWA_KM} km, dalej po uzgodnieniu. ${miejsca.length} miejscowości w ${wojewodztwa.length} województwach.`}
>
  <PageShell>
    <PageHeader
      slot="header"
      title="Mapa dystrybucji"
      lead={`Nasz magazyn jest we Władysławowie pod Bieżuniem. W promieniu ok. ${DARMOWA_DOSTAWA_KM} km od magazynu dowozimy pellet gratis, dalej warunki ustalamy indywidualnie. Kliknij punkt na mapie, aby zobaczyć odległość.`}
    />

    <Mapa miejsca={miejsca} strefa label="Mapa: magazyn, strefa darmowej dostawy i miejscowości, do których dowozimy" />
    <p class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-sm font-medium">
      <span><span class="legend-pin legend-pin-magazyn"></span> magazyn</span>
      <span><span class="legend-zone"></span> strefa darmowej dostawy (ok. {DARMOWA_DOSTAWA_KM} km)</span>
      <span><span class="legend-dot legend-dot-strefa"></span> miejscowość w strefie</span>
      <span><span class="legend-dot legend-dot-poza"></span> poza strefą, dostawa po uzgodnieniu</span>
    </p>

    <section class="mt-12" aria-labelledby="podstrony">
      <h2 id="podstrony" class="text-3xl">Dostawa w Twojej okolicy</h2>
      {
        grupyPodstron.map((g) => (
          <div class="mt-6">
            <h3 id={`podstrony-${g.id}`} class="text-xl">
              {g.tytul}
            </h3>
            <ul role="list" class="tablice mt-3" aria-labelledby={`podstrony-${g.id}`} data-ruch-grupa="tablica">
              {g.miasta.map((m) => (
                <li>
                  <Tablica miejsce={m} href={miejsceHref(m)} />
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section class="mt-12" aria-labelledby="wszystkie">
      <h2 id="wszystkie" class="text-3xl">Wszystkie miejscowości</h2>
      <p class="mt-2 max-w-prose text-ink-soft">
        Odległość od magazynu w linii prostej. Miejscowości w strefie darmowej dostawy są oznaczone
        „gratis”.
      </p>
      <div class="miejscowosci mt-6">
        {
          grupy.map((g, i) => (
            <section aria-labelledby={`wojewodztwo-${i}`}>
              <h3 id={`wojewodztwo-${i}`} class="text-xl">Województwo {g.wojewodztwo}</h3>
              <ul role="list" class="mt-3">
                {g.miejsca.map((m) => (
                  <li class="flex justify-between gap-4 border-b border-line py-1">
                    <span>
                      <NazwaMiejsca miejsce={m} />
                    </span>
                    <span class="shrink-0 text-sm">
                      {wStrefieDarmowej(m) && <span class="tag-gratis mr-2">gratis</span>}
                      <span class="font-semibold">{odlegloscKm(m)} km</span>
                    </span>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </section>

    <p class="mt-12 max-w-prose text-ink-soft">
      Dowozimy też do okolicznych wsi, a na Mazury praktycznie wszędzie. Nie ma Twojej miejscowości?
      Wszystko jest kwestią dogadania: zadzwoń pod{" "}
      <a href={firma.phone.href} class="link-strong">{firma.phone.label}</a>.
    </p>
  </PageShell>
</Base>

<style>
  /* One long list in newspaper columns, so the five voivodeships fill the
     columns evenly instead of one tall column beside short ones. A list may
     go on in the next column; a heading never ends one. */
  .miejscowosci {
    column-gap: 2.5rem;
  }
  @media (min-width: 48rem) {
    .miejscowosci {
      columns: 2;
    }
  }
  @media (min-width: 64rem) {
    .miejscowosci {
      columns: 3;
    }
  }
  .miejscowosci section + section {
    margin-top: 2rem;
  }
  .miejscowosci h3 {
    break-after: avoid;
  }
  .miejscowosci li {
    break-inside: avoid;
  }
</style>
