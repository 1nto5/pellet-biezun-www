---
import Base from "../layouts/Base.astro";
import PageShell from "../components/PageShell.astro";
import PageHeader from "../components/PageHeader.astro";
import Mapa from "../components/Mapa.astro";
import { firma } from "../data/firma";
import { miejsca, miejsceHref } from "../data/miejsca";
import { distanceKm } from "../lib/geo";

const punkty = miejsca.filter((m) => m.rodzaj === "punkt");
const dostawy = miejsca.filter((m) => m.rodzaj === "dostawa");
---

<Base
  title="Mapa dystrybucji"
  description={`Punkty sprzedaży i miejscowości, do których dowozimy pellet: ${miejsca.map((m) => m.nazwa).join(", ")}.`}
>
  <PageShell>
    <PageHeader
      slot="header"
      title="Mapa dystrybucji"
      lead="Gdzie kupić nasz pellet i dokąd go dowozimy. Kliknij znacznik albo miejscowość z listy, aby zobaczyć warunki dostawy."
    />

    <Mapa miejsca={miejsca} label="Mapa punktów sprzedaży i miejscowości dostaw" />
    <p class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-sm text-ink-soft">
      <span><span class="legend-pin" style="background:#85522a"></span> punkt sprzedaży</span>
      <span><span class="legend-pin" style="background:#1f5a46"></span> dostawa</span>
    </p>

    <div class="mt-12 grid gap-12 md:grid-cols-2">
      <section aria-labelledby="punkty">
        <h2 id="punkty" class="text-2xl">Punkty sprzedaży</h2>
        <ul role="list" class="rows mt-4">
          {
            punkty.map((m) => (
              <li>
                <a href={miejsceHref(m)}>
                  <span>{m.nazwa}</span>
                  <p>{m.adres}</p>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
      <section aria-labelledby="dostawy">
        <h2 id="dostawy" class="text-2xl">Dowozimy do</h2>
        <ul role="list" class="rows mt-4">
          {
            dostawy.map((m) => (
              <li>
                <a href={miejsceHref(m)}>
                  <span>{m.nazwa}</span>
                  <p>około {distanceKm(firma.geo, m.geo)} km od Bieżunia · {m.dostawa}</p>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <p class="mt-10 max-w-prose text-ink-soft">
      Nie ma Twojej miejscowości? Zadzwoń pod <a href={firma.phone.href}>{firma.phone.label}</a>,
      często dowozimy także dalej.
    </p>
  </PageShell>
</Base>
