---
import Base from "../layouts/Base.astro";
import PageShell from "../components/PageShell.astro";
import PageHeader from "../components/PageHeader.astro";
import Mapa from "../components/Mapa.astro";
import NazwaMiejsca from "../components/NazwaMiejsca.astro";
import Tablica from "../components/Tablica.astro";
import { firma } from "../data/firma";
import { nazwaWlasna } from "../lib/miejsce";
import {
  ZASADA_DOSTAWY,
  miejsca,
  podstronyPoOdleglosci,
  wojewodztwa,
  miejsceHref,
  odlegloscKm,
} from "../data/miejsca";

// Every town by voivodeship, nearest first.
const grupy = wojewodztwa
  .map((w) => ({
    wojewodztwo: w,
    miejsca: miejsca.filter((m) => m.wojewodztwo === w).sort((a, b) => odlegloscKm(a) - odlegloscKm(b)),
  }))
  .filter((g) => g.miejsca.length > 0);
---

<Base
  title="Mapa dystrybucji: dokąd dowozimy pellet"
  description={`Dokąd dowozimy pellet z magazynu we Władysławowie pod Bieżuniem: ${miejsca.length} miejscowości w ${wojewodztwa.length} województwach. ${ZASADA_DOSTAWY}`}
>
  <PageShell>
    <PageHeader
      slot="header"
      title="Mapa dystrybucji"
      lead={`Nasz magazyn jest we Władysławowie pod Bieżuniem. ${ZASADA_DOSTAWY}`}
    />

    {/* Beside the map, never in it: Leaflet draws into an empty box. Only the
        page script makes it work, so without scripts it is not shown. */}
    <div class="szukaj mb-5" data-szukaj data-tel={firma.phone.label} data-tel-href={firma.phone.href}>
      <form role="search" class="szukaj-form">
        <div class="field">
          <label for="szukaj-miejsce">Sprawdź swoją miejscowość</label>
          <input
            id="szukaj-miejsce"
            type="text"
            class="input"
            placeholder="np. Mława"
            autocomplete="off"
            autocapitalize="words"
            enterkeyhint="search"
            list="szukaj-miejscowosci"
            maxlength="100"
          />
          <datalist id="szukaj-miejscowosci">
            {miejsca.map((m) => <option value={nazwaWlasna(m)} />)}
          </datalist>
        </div>
        <button type="submit" class="btn btn-primary">Pokaż na mapie</button>
      </form>
      <p class="szukaj-wynik" aria-live="polite" data-wynik data-podpowiedz>Możesz też wybrać miejscowość na mapie.</p>
    </div>

    <Mapa miejsca={miejsca} trasy class="mapa-dystrybucja" label="Mapa: magazyn i miejscowości, do których dowozimy" />
    <p class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-sm font-medium">
      <span><span class="legend-pin legend-pin-magazyn"></span> magazyn</span>
      <span><span class="legend-dot"></span> miejscowość, do której dowozimy</span>
      <span><span class="legend-trasa"></span> trasa z&nbsp;magazynu do wybranej miejscowości</span>
    </p>

    <section class="mt-12" aria-labelledby="podstrony">
      <h2 id="podstrony" class="text-3xl">Dostawa w Twojej okolicy</h2>
      <ul role="list" class="tablice mt-6" data-ruch-grupa="tablica">
        {
          podstronyPoOdleglosci.map((m) => (
            <li>
              <Tablica miejsce={m} href={miejsceHref(m)} />
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12" aria-labelledby="wszystkie">
      <h2 id="wszystkie" class="text-3xl">Wszystkie miejscowości</h2>
      <p class="tylko-js mt-2 text-ink-soft">Wybierz miejscowość, żeby zobaczyć ją na mapie.</p>
      <div class="miejscowosci mt-6">
        {
          grupy.map((g, i) => (
            <section aria-labelledby={`wojewodztwo-${i}`}>
              <h3 id={`wojewodztwo-${i}`} class="text-xl">Województwo {g.wojewodztwo}</h3>
              <ul role="list" class="mt-3">
                {g.miejsca.map((m) => (
                  <li class="border-b border-line py-1" data-miejsce={m.nazwa}>
                    <NazwaMiejsca miejsce={m} />
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </section>

    <p class="mt-12 max-w-prose text-ink-soft">
      Dowozimy też do okolicznych wsi, a na Mazurach niemal wszędzie. Nie ma Twojej miejscowości?
      Zadzwoń pod <a href={firma.phone.href} class="link-strong">{firma.phone.label}</a>, ustalimy
      szczegóły.
    </p>
  </PageShell>
</Base>

<script>
  import type { DaneMapy } from "../components/mapa";

  // The search field and the town list steer the map through an event on
  // its element (see mapa.ts): `mapa:wybierz` chooses a town, and the map
  // answers with `mapa:wybrano`, whatever chose the town.
  const mapa = document.querySelector<HTMLElement>(".mapa[data-trasy]");
  const szukaj = document.querySelector<HTMLElement>("[data-szukaj]");
  const pole = szukaj?.querySelector<HTMLInputElement>("input");
  const wynik = szukaj?.querySelector<HTMLElement>("[data-wynik]");

  if (mapa && szukaj && pole && wynik) {
    // The towns as the map has them: `klucz` is the bare name, `nazwa` the
    // name with its note ("Nowe Miasto k. Płońska").
    type Miejsce = DaneMapy["miejsca"][number];
    const miejsca = (JSON.parse(mapa.dataset.mapa ?? "{}") as DaneMapy).miejsca;
    // The line under the field starts as a hint, small and muted
    // (`data-podpowiedz`), gives way to an answer and comes back when the
    // answer no longer holds.
    const tekstPodpowiedzi = wynik.textContent ?? "";
    function odpowiedz(...tresc: (string | Node)[]): void {
      wynik!.replaceChildren(...tresc);
      wynik!.removeAttribute("data-podpowiedz");
    }
    function podpowiedz(): void {
      wynik!.textContent = tekstPodpowiedzi;
      wynik!.setAttribute("data-podpowiedz", "");
    }
    const bezRuchu = window.matchMedia("(prefers-reduced-motion: reduce)");

    // "mlawa" finds Mława and "golub dobrzyn" Golub-Dobrzyń: letters compared
    // without case, Polish marks or punctuation. ł is a letter of its own,
    // not l with a mark, so it is replaced by hand.
    const zloz = (tekst: string) =>
      tekst
        .toLowerCase()
        .replace(/ł/g, "l")
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/[^a-z0-9]+/g, " ")
        .trim();
    // A town's name without how often we go there: "Mikołajki (czasem)" is
    // "Mikołajki" in the field, "Lidzbark Welski" stays whole.
    const wlasna = (m: Miejsce) => m.nazwa.replace(/ \([^)]*\)$/, "");
    const zlozone = miejsca.map((m) => ({ m, cale: [zloz(wlasna(m)), zloz(m.nazwa)], nazwy: [zloz(m.klucz), zloz(wlasna(m))] }));

    /**
     * The whole name first, then names that start with the text, then names
     * that hold it. Two towns are "Lidzbark" and two "Nowe Miasto", so only a
     * whole name with its second part counts as the whole name: "Lidzbark"
     * alone finds both, and the reader picks. A name typed as the page
     * prints it, "Mikołajki (czasem)", is a whole name too.
     */
    function pasujace(tekst: string): Miejsce[] {
      const szukane = zloz(tekst);
      const proby: ((z: (typeof zlozone)[number]) => boolean)[] = [
        (z) => z.cale.includes(szukane),
        (z) => z.nazwy.some((n) => n.startsWith(szukane)),
        (z) => z.nazwy.some((n) => n.includes(szukane)),
      ];
      for (const pasuje of proby) {
        const znalezione = zlozone.filter(pasuje);
        if (znalezione.length > 0) return znalezione.map((z) => z.m);
      }
      return [];
    }

    // The map is drawn only when it comes near the screen; a town picked
    // before that waits for it. Only the last pick counts.
    // `null` chooses no town: a search that found none takes the last one's
    // road off the map.
    let czeka: string | null | undefined;
    function wybierz(klucz: string | null): void {
      if ("gotowa" in mapa!.dataset) mapa!.dispatchEvent(new CustomEvent("mapa:wybierz", { detail: { klucz } }));
      else czeka = klucz;
    }
    mapa.addEventListener(
      "mapa:gotowa",
      () => {
        if (czeka !== undefined) wybierz(czeka);
        czeka = undefined;
      },
      { once: true },
    );

    // The town the line under the field speaks of. When the map says another
    // town is chosen, or none, the line no longer holds and goes.
    let potwierdzona: string | undefined;
    // The town's name as this script last wrote it into the field.
    let wPolu = "";
    function potwierdz(m: Miejsce): void {
      potwierdzona = m.klucz;
      pole!.value = wPolu = wlasna(m);
      odpowiedz(`Tak, dowozimy do miejscowości ${m.nazwa}.`);
      wybierz(m.klucz);
      // The whole map, with the answer above it, comes into the window if a
      // part of it was below the edge.
      mapa!.scrollIntoView({ behavior: bezRuchu.matches ? "instant" : "smooth", block: "nearest" });
    }

    szukaj.querySelector("form")?.addEventListener("submit", (e) => {
      e.preventDefault();
      const wpisane = pole.value.trim();
      potwierdzona = undefined;
      if (!wpisane) {
        podpowiedz();
        pole.focus();
        return;
      }
      const znalezione = pasujace(wpisane);
      const [jedyna] = znalezione;
      if (jedyna && znalezione.length === 1) {
        potwierdz(jedyna);
      } else if (znalezione.length > 6) {
        odpowiedz(`Pasujących miejscowości: ${znalezione.length}. Wpisz więcej liter.`);
        wybierz(null);
      } else if (znalezione.length > 1) {
        // The names come from our own list, but they too go in as text.
        const przyciski = znalezione.map((m) => {
          const przycisk = Object.assign(document.createElement("button"), { type: "button", className: "btn btn-secondary btn-sm", textContent: m.nazwa });
          przycisk.addEventListener("click", () => {
            potwierdz(m);
            pole.focus();
          });
          return przycisk;
        });
        odpowiedz("Która miejscowość? ", ...przyciski);
        wybierz(null);
      } else {
        // What the reader typed goes in as text, never as markup.
        const tel = Object.assign(document.createElement("a"), { href: szukaj.dataset.telHref ?? "", textContent: szukaj.dataset.tel ?? "", className: "link-strong" });
        odpowiedz(
          `Nie mamy na liście miejscowości „${wpisane}”. Dowozimy też do okolicznych wsi, a\u00a0na Mazurach niemal wszędzie. Zadzwoń pod `,
          tel,
          ", ustalimy szczegóły.",
        );
        wybierz(null);
      }
    });

    // Every town of the list becomes a button that shows it on the map.
    // Without scripts the list stays plain text.
    const pozycje = [...document.querySelectorAll<HTMLElement>("[data-miejsce]")];
    for (const pozycja of pozycje) {
      const przycisk = Object.assign(document.createElement("button"), { type: "button" });
      przycisk.append(...pozycja.childNodes);
      przycisk.addEventListener("click", () => {
        wybierz(pozycja.dataset.miejsce!);
        mapa.scrollIntoView({ behavior: bezRuchu.matches ? "instant" : "smooth", block: "center" });
        // The keyboard goes with the reader to the map: the next Tab is in
        // the town's popup, not back in the list, now out of the window.
        mapa.focus({ preventScroll: true });
      });
      pozycja.append(przycisk);
    }

    // Whatever chose the town (the field, the list, a click on a dot), the
    // list marks it and the field names it. When no town is chosen any more,
    // the field is emptied only if it still holds that town's name: what the
    // reader has typed since stays.
    mapa.addEventListener("mapa:wybrano", (e) => {
      const klucz: string | null = (e as CustomEvent).detail.klucz;
      for (const pozycja of pozycje) {
        const przycisk = pozycja.querySelector("button");
        if (pozycja.dataset.miejsce === klucz) przycisk?.setAttribute("aria-current", "true");
        else przycisk?.removeAttribute("aria-current");
      }
      const m = miejsca.find((miejsce) => miejsce.klucz === klucz);
      if (m) pole.value = wPolu = wlasna(m);
      else if (pole.value === wPolu) pole.value = "";
      // The line under the field goes back to its hint when it speaks of a
      // town that is no longer the chosen one, or says "not on the list"
      // while the reader has picked a town on the map.
      const nieaktualna = potwierdzona !== undefined ? klucz !== potwierdzona : klucz !== null;
      if (nieaktualna) {
        potwierdzona = undefined;
        podpowiedz();
      }
    });
  }
</script>

<style>
  /* The search above the map and the hint over the list work only through
     the page script. */
  :global(html:not([data-js])) :is(.szukaj, .tylko-js) {
    display: none;
  }
  /* On a phone the field and the button stack; from a tablet up they share
     a row, the button level with the field under its label. */
  .szukaj-form {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 48rem) {
    .szukaj-form {
      grid-template-columns: minmax(0, 24rem) auto;
      align-items: end;
      justify-content: start;
    }
  }
  /* The line under the field: a hint, then the answer in its place, so the
     map below does not jump when the answer comes. Its buttons are made by
     the script, hence `:global`. */
  .szukaj-wynik {
    max-width: 65ch;
    margin-top: 0.75rem;
    font-weight: 600;
  }
  .szukaj-wynik[data-podpowiedz] {
    color: var(--color-ink-soft);
    font-weight: 400;
  }
  .szukaj-wynik :global(.btn) {
    margin-block: 0.25rem;
  }

  /* A town of the list is a button made by the page script (hence
     `:global`) that looks like the text it replaced and fills its row. */
  .miejscowosci :global(button) {
    display: block;
    width: 100%;
    margin-block: -0.25rem;
    padding: 0.25rem 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: start;
    cursor: pointer;
  }
  .miejscowosci :global(button:hover) {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }
  /* The town chosen on the map: the road's yellow beside it, and heavier. */
  .miejscowosci li:has(> :global(button[aria-current="true"])) {
    padding-inline-start: 0.6rem;
    box-shadow: inset 0.3rem 0 0 var(--color-yellow);
    background: var(--color-sand);
    font-weight: 800;
  }

  /* One long list in newspaper columns, so the five voivodeships fill the
     columns evenly instead of one tall column beside short ones. A list may
     go on in the next column; a heading never ends one. */
  .miejscowosci {
    column-gap: 2.5rem;
  }
  @media (min-width: 48rem) {
    .miejscowosci {
      columns: 2;
    }
  }
  @media (min-width: 64rem) {
    .miejscowosci {
      columns: 3;
    }
  }
  .miejscowosci section + section {
    margin-top: 2rem;
  }
  .miejscowosci h3 {
    break-after: avoid;
  }
  .miejscowosci li {
    break-inside: avoid;
  }
</style>
