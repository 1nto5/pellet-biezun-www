---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import Pasy from "../components/Pasy.astro";
import Tablica from "../components/Tablica.astro";
import TablicaWjazdowa from "../components/TablicaWjazdowa.astro";
import Droga from "../components/droga/Droga.astro";
import { Image } from "astro:assets";
import { firma, firmaId, addressLine, hoursRange } from "../data/firma";
import { orderLink, strony } from "../data/nav";
import { absoluteUrl } from "../lib/url";
import { produkty, cenyLabel, paletaLabel } from "../data/oferta";
import { DARMOWA_DOSTAWA_KM, grupyPodstron, miejsceHref } from "../data/miejsca";

/** "Pellet Bieżuń" → the two lines of the sign. */
const [pellet, miasto] = firma.znak;

/** The site itself, so search results show the company's name as the site's. */
const webSite = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: firma.name,
  url: absoluteUrl("/"),
  inLanguage: "pl-PL",
  publisher: { "@id": firmaId },
};

/** Bag weights on offer; one number while every product comes in the same bag. */
const workiKg = [...new Set(produkty.map((p) => p.workiKg))].join(" i ");
---

<Base jsonLd={[webSite]}>
  <Droga>
    <section class="hero page-wrap" aria-labelledby="hero-title">
      <h1 id="hero-title" class="wordmark">
        <span class="wordmark-pellet">{pellet}</span>
        <span class="wordmark-miasto">{miasto}</span>
        <!-- Read aloud and indexed as "Pellet Bieżuń – pellet drzewny…", not one run of words. -->
        <span class="sr-only"> – </span>
        <span class="wordmark-opis">pellet drzewny z dostawą</span>
      </h1>
      <div class="hero-dol">
        <p class="hero-fakt">
          Sprzedajemy pellet drzewny w workach {workiKg} kg na paletach. Dowozimy gratis do ok.&nbsp;{DARMOWA_DOSTAWA_KM}&nbsp;km {firma.odMiasta}.
        </p>
        <div class="hero-akcje">
          <Button href={orderLink.href}>{orderLink.label}</Button>
          <a href={firma.phone.href} class="telefon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"
              ><path
                fill="currentColor"
                d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"
              ></path></svg
            >
            <span class="sr-only">Zadzwoń: </span>{firma.phone.label}
          </a>
        </div>
      </div>
    </section>
  </Droga>

  <section class="page-wrap pt-10 pb-16 md:pt-14 md:pb-24" aria-labelledby="oferta-skrot">
    <div class="baner ramka">
      <p class="naklejka">
        <span>Większe zamówienie?</span>
        <strong>Cena do negocjacji</strong>
      </p>
      <h2 id="oferta-skrot" class="text-3xl md:text-4xl">Co przywozimy</h2>
      <ul role="list" class="mt-8 grid gap-10 lg:grid-cols-2" data-ruch-grupa>
        {
          produkty.map((p) => {
            const [cena = "", cenaTona] = cenyLabel(p);
            // "2200 zł" and "/ paleta", the second set smaller.
            const [kwota, za] = cena.split(" /");
            return (
              <li class="produkt">
                <Image
                  src={p.zdjecie.src}
                  alt={p.zdjecie.alt}
                  width={400}
                  widths={[240, 400]}
                  sizes="(min-width: 48rem) 12rem, 40vw"
                  class="produkt-foto"
                />
                <div>
                  <h3 class="text-xl md:text-2xl">{p.nazwa}</h3>
                  <p class="mt-1 text-ink-soft">{paletaLabel(p)}</p>
                  <p class="price mt-3 text-xl sm:text-2xl">
                    {kwota}
                    <span class="price-za">/{za}</span>
                  </p>
                  {cenaTona && <p class="text-ink-soft">{cenaTona}</p>}
                </div>
              </li>
            );
          })
        }
      </ul>
      <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
        <Button href={orderLink.href}>{orderLink.label}</Button>
        <a href={firma.phone.href} class="telefon">
          <span class="sr-only">Zadzwoń: </span>{firma.phone.label}
        </a>
      </div>
    </div>
  </section>

  <section class="page-wrap pb-16 md:pb-24" aria-labelledby="dostawy-skrot">
    <Pasy />
    <h2 id="dostawy-skrot" class="mt-6 text-3xl md:text-4xl">Gdzie dowozimy</h2>
    <p class="mt-3 max-w-prose text-lg">
      W promieniu ok. {DARMOWA_DOSTAWA_KM} km od magazynu dowozimy gratis, dalej warunki ustalamy
      indywidualnie. Odległości podajemy w linii prostej.
    </p>
    {
      grupyPodstron.map((g) => (
        <div class="mt-8">
          <h3 id={`dostawa-${g.id}`} class="text-xl">
            {g.tytul}
          </h3>
          <ul role="list" class="tablice mt-3" aria-labelledby={`dostawa-${g.id}`} data-ruch-grupa="tablica">
            {g.miasta.map((m) => (
              <li>
                <Tablica miejsce={m} href={miejsceHref(m)} />
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    <p class="mt-8 text-lg">
      Mniejsze miejscowości i wsie są na <a href={strony.mapa.href} class="link-strong">mapie dystrybucji</a>.
    </p>
  </section>

  <section class="kontakt" aria-labelledby="kontakt-skrot">
    <div class="page-wrap grid grid-cols-[minmax(0,1fr)] gap-10 py-16 md:py-20 lg:grid-cols-[minmax(0,26rem)_minmax(0,1fr)] lg:items-center lg:gap-16">
      <div class="max-w-[26rem]" data-ruch="tablica"><TablicaWjazdowa /></div>
      <div>
        <h2 id="kontakt-skrot" class="text-3xl md:text-4xl">Magazyn i kontakt</h2>
        <address class="mt-4 text-lg">
          {addressLine()}<br />
          tel. <a href={firma.phone.href} class="link-strong">{firma.phone.label}</a>
        </address>
        <p class="mt-2 text-ink-soft">
          {firma.hours.map((h, i) => `${i ? h.label.toLowerCase() : h.label} ${hoursRange(h)}`).join(", ")}. Odbiór osobisty po
          wcześniejszym telefonie.
        </p>
        <div class="mt-6">
          <Button href={strony.kontakt.href} variant="secondary">Kontakt i formularz</Button>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* The sign at poster size: PELLET as wide as the column, the town under
     it spaced out to the same width, as on the banner. The capitals are a
     style; the heading reads "Pellet Bieżuń". */
  .hero {
    padding-top: clamp(0.75rem, 2.5svh, 2rem);
    padding-bottom: 1rem;
    overflow-x: clip;
  }
  .wordmark {
    --wm: min(27vw, 30svh, 17rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-transform: uppercase;
    font-weight: 900;
    line-height: 0.8;
    letter-spacing: -0.045em;
    /* One word a line; a reader's wider letter spacing may still break a
       word rather than push it out of the page. */
    overflow-wrap: anywhere;
  }
  .wordmark-pellet {
    font-size: var(--wm);
    margin-left: -0.04em;
  }
  /* Set like the sign: heavy, normal tracking, sized to end under the T. */
  .wordmark-miasto {
    margin-top: 0.2em;
    margin-left: -0.03em;
    font-size: calc(var(--wm) * 0.915);
    letter-spacing: -0.02em;
  }
  /* The rest of the h1, so search engines read what the company does, not
     only its name. */
  .wordmark-opis {
    margin-top: 0.6rem;
    font-size: clamp(1.05rem, 1.6vw, 1.35rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: none;
  }
  .hero-dol {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.25rem;
  }
  .hero-fakt {
    max-width: 34ch;
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.35;
  }
  .hero-akcje {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  /* Phones and other upright windows. Over the phone's drive (droga.css,
     where `--scena-h` is set) the first screen holds the hero and the
     drive's whole scene under it: the wordmark, 1.715 times its font size
     tall, gives way as far as that needs, down to a floor on the lowest
     windows. `--reszta` is the rest of the hero by its sizes here: the
     paddings, the line under the wordmark, three lines of facts, the row of
     actions, and a strip of white under the scene's road. Without the drive
     the wordmark keeps its own size: `--wm-ekran` is then invalid, and the
     fallback is taken. */
  @media (width < 56rem), (aspect-ratio < 1) {
    .hero {
      --reszta: 13.1rem;
      --wm-ekran: calc((100svh - var(--header-height) - var(--scena-h) - var(--reszta) + var(--bez-opisu, 0rem)) / 1.715);
      padding-bottom: 0.75rem;
    }
    .wordmark {
      --wm: max(3.5rem, min(27vw, 30svh, 17rem, var(--wm-ekran, 17rem)));
    }
    .hero-dol {
      gap: 0.9rem;
      margin-top: 1rem;
    }
    .hero-fakt {
      font-size: 1.05rem;
    }
    /* The order button and the phone side by side, sized to fit a 360 px
       phone; a narrower one has them one under the other, and room for a
       fourth line of facts. */
    .hero-akcje {
      flex-wrap: nowrap;
      gap: 0.75rem;
    }
    .hero :global(.btn) {
      padding-inline: min(1.6rem, 6vw);
    }
    .hero .telefon {
      font-size: clamp(1.1rem, 5.6vw, 1.5rem);
    }
  }
  @media (width < 22.5rem) {
    .hero {
      --reszta: 17.7rem;
    }
    .hero-akcje {
      flex-wrap: wrap;
    }
  }
  /* The lowest phones held upright (a 4.7-inch one in a browser): the line
     under the wordmark, which the facts say again, is only read out, so the
     wordmark and the scene both still fit. */
  @media (orientation: portrait) and (height < 37.5rem) {
    .hero {
      --bez-opisu: 1.85rem;
    }
    .wordmark-opis {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  /* Wide landscape windows: the facts and the two actions beside the
     wordmark, at its foot. The wordmark leaves them at least 17rem: PELLET
     is about 3.2 times its font size wide. Should they still not fit (a
     reader's own wider letter spacing), they go under it. An upright window
     keeps the phone's layout, which suits its height. */
  @media (min-width: 56rem) and (min-aspect-ratio: 1 / 1) {
    .hero {
      --odstep: clamp(2rem, 5vw, 4.5rem);
      container-type: inline-size;
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      gap: 1.25rem var(--odstep);
    }
    .wordmark {
      --wm: min(30svh, 17rem, (100cqi - 17rem - var(--odstep)) / 3.2);
      flex: none;
    }
    .hero-dol {
      flex: 1 0 17rem;
      max-width: 24rem;
      margin-top: 0;
      padding-bottom: 0.3rem;
    }
    .hero-fakt {
      font-size: 1.3rem;
    }
  }

  /* The phone written like on the truck: big, heavy, black. */
  .telefon {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    /* A finger's target, 44 px, though the text is shorter. */
    min-height: 2.45rem;
    color: var(--color-black);
    font-size: clamp(1.3rem, 5vw, 1.5rem);
    font-weight: 900;
    letter-spacing: -0.01em;
    text-decoration-line: underline;
    text-decoration-color: var(--color-yellow);
    text-decoration-thickness: 0.2rem;
    text-underline-offset: 0.2em;
  }
  .telefon:hover {
    color: var(--color-black);
    text-decoration-thickness: 0.3rem;
  }
  .telefon svg {
    width: 1.1em;
    height: 1.1em;
  }

  /* The banner: the offer in a yellow frame (`.ramka`), with a sticker. */
  .baner {
    position: relative;
    padding: 1.75rem 1.25rem;
  }
  @media (min-width: 40rem) {
    .baner {
      padding: 2.5rem 2.75rem;
    }
  }
  /* A shop-window sticker, after the red "DOSTAWA GRATIS!" disc on the
     printer's banner: stuck over the panel's corner on wide screens, a tilted
     tag under the heading on phones. */
  .naklejka {
    display: inline-flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-bottom: 1.25rem;
    padding: 0.7rem 1.1rem;
    background: var(--color-red);
    color: var(--color-white);
    border-radius: 0.75rem;
    transform: rotate(-3deg);
    line-height: 1.1;
    text-align: center;
  }
  .naklejka span {
    font-size: 0.95rem;
    font-weight: 700;
  }
  .naklejka strong {
    font-size: 1.3rem;
    font-weight: 900;
    text-transform: uppercase;
  }
  @media (min-width: 48rem) {
    .naklejka {
      position: absolute;
      top: -2.75rem;
      right: 2rem;
      justify-content: center;
      width: 11rem;
      aspect-ratio: 1;
      margin: 0;
      padding: 1rem;
      border-radius: 50%;
      transform: rotate(-10deg);
      box-shadow: 0 0 0 0.3rem var(--color-white);
    }
    .naklejka strong {
      font-size: 1.35rem;
    }
  }
  /* The narrowest phones keep the bag small, so "Wielbarku" fits its line
     whole rather than break inside the word. */
  .produkt {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.875rem;
  }
  @media (min-width: 24rem) {
    .produkt {
      grid-template-columns: 7rem minmax(0, 1fr);
      gap: 1.25rem;
    }
  }
  @media (min-width: 40rem) {
    .produkt {
      grid-template-columns: 10rem minmax(0, 1fr);
    }
  }
  /* Packshots are shot on white; multiply lets that white vanish into the
     page, so only the bag and its shadow show. */
  .produkt-foto {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .kontakt {
    background: var(--color-sand);
  }
  /* "/ paleta" smaller than the sum, so the price keeps to one line. */
  .price-za {
    font-size: 0.72em;
    font-weight: 700;
  }
</style>
