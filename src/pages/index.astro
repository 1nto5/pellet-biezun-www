---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import Tablica from "../components/Tablica.astro";
import Droga from "../components/droga/Droga.astro";
import { Image } from "astro:assets";
import { firma, firmaId, addressLine, hoursRange } from "../data/firma";
import { orderLink, strony } from "../data/nav";
import { absoluteUrl } from "../lib/url";
import { produkty, cenyLabel, cenaLabel, cenaWorkaLabel, paletaLabel } from "../data/oferta";
import { flota, najdluzszy, szczegolyLabel } from "../data/flota";
import { faq } from "../data/faq";
import { DARMOWA_DOSTAWA_KM, podstronyPoOdleglosci, miejsceHref } from "../data/miejsca";

/** "Pellet Bieżuń" → the two lines of the sign. */
const [pellet, miasto] = firma.znak;

/** The two questions the delivery stop answers, from the FAQ page. */
const pytania = ["Ile kosztuje dostawa?", "Czy pellet można trzymać na zewnątrz?"].map((q) => {
  const f = faq.find((x) => x.q === q);
  // A question reworded in faq.ts would leave the stop with a gap: better a failed build.
  if (!f) throw new Error(`No FAQ entry "${q}" for the home page's delivery stop (faq.ts).`);
  return f;
});

/**
 * The delivery stop's three tiles: what the reader asks first. A line under
 * the title only where no other place on the page says it.
 */
const kafelki: { tytul: string; tekst?: string }[] = [
  { tytul: `Dostawa gratis ${DARMOWA_DOSTAWA_KM} km` },
  { tytul: "Winda i wózek paletowy", tekst: "paletę zdejmujemy z auta i podwozimy na miejsce" },
  { tytul: "Iveco Daily na dojazd w trudno dostępne miejsca" },
];

/** Each vehicle's width on its strip, as a share of the longest's. */
const auta = flota.map((f) => ({ ...f, procent: Math.round((f.m / najdluzszy) * 1000) / 10 }));

/** The site itself, so search results show the company's name as the site's. */
const webSite = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: firma.name,
  url: absoluteUrl("/"),
  inLanguage: "pl-PL",
  publisher: { "@id": firmaId },
};
---

<Base jsonLd={[webSite]}>
  <Droga>
    <section class="hero page-wrap" aria-labelledby="hero-title">
      <div class="hero-znak">
        <h1 id="hero-title" class="wordmark">
          <span class="wordmark-pellet">{pellet}</span>
          <span class="wordmark-miasto">{miasto}</span>
        </h1>
        <p class="naklejka">
          <span>Dostawa gratis</span>
          <strong>{DARMOWA_DOSTAWA_KM}&nbsp;km!</strong>
        </p>
      </div>
      <div class="hero-dol">
        <div class="hero-akcje">
          <Button href={orderLink.href}>{orderLink.label}</Button>
          <a href={firma.phone.href} class="telefon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"
              ><path
                fill="currentColor"
                d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"
              ></path></svg
            >
            <span class="sr-only">Zadzwoń: </span>{firma.phone.label}
          </a>
        </div>
      </div>
    </section>

    <div slot="zaladunek" class="produkty ramka">
      <ul role="list" class="produkty-lista">
        {
          produkty.map((p) => {
            const tona = cenyLabel(p)[1];
            const worek = cenaWorkaLabel(p);
            return (
              <li class="produkt">
                <Image
                  src={p.zdjecie.src}
                  alt={p.zdjecie.alt}
                  width={240}
                  widths={[120, 240]}
                  sizes="5rem"
                  class="produkt-foto"
                />
                <div class="produkt-opis">
                  <h3>{p.nazwa}</h3>
                  <p class="miekki">{paletaLabel(p)}</p>
                  <p class="cena-tag produkt-cena">{cenaLabel(p)}</p>
                  {(tona || worek) && <p class="miekki">{[tona, worek && `worek ${worek}`].filter(Boolean).join(" · ")}</p>}
                  <a href={`${strony.oferta.href}#produkt-${p.id}`} class="link-strong">
                    Parametry<span class="sr-only">: {p.nazwa}</span>
                    <span aria-hidden="true">→</span>
                  </a>
                </div>
              </li>
            );
          })
        }
      </ul>
      <p class="naklejka">
        <span>Większe zamówienie?</span>
        <strong>Cena do negocjacji</strong>
      </p>
    </div>

    <div slot="w-drodze" class="flota">
      <ul role="list" class="flota-lista">
        {
          auta.map((f) => (
            <li class="flota-auto">
              <div class="flota-opis">
                <p class="flota-model">{f.model}</p>
                <p class="miekki">{szczegolyLabel(f)}</p>
              </div>
              <span class="flota-pas">
                <span class="flota-foto" style={`width:${f.procent}%`}>
                  <Image
                    src={f.zdjecie}
                    alt={f.alt}
                    width={800}
                    widths={[200, 400, 600, 800]}
                    sizes={`(min-width: 64rem) calc(${f.procent / 100} * 18rem), calc(${f.procent / 100} * 92vw)`}
                  />
                </span>
              </span>
            </li>
          ))
        }
      </ul>
      <p class="tresc-link">
        <a href={`${strony.oferta.href}#flota`} class="link-strong">Flota w ofercie <span aria-hidden="true">→</span></a>
      </p>
    </div>

    <div slot="miasta" class="miasta">
      <ul role="list" class="tablice">
        {
          podstronyPoOdleglosci.map((m) => (
            <li>
              <Tablica miejsce={m} href={miejsceHref(m)} />
            </li>
          ))
        }
      </ul>
      <p class="tresc-link">
        <a href={strony.mapa.href} class="link-strong">
          Sprawdź swoją miejscowość na mapie dystrybucji <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>

    <div slot="na-miejscu" class="dostawa">
      <ul role="list" class="kafelki">
        {
          kafelki.map((k) => (
            <li>
              <strong>{k.tytul}</strong>
              {k.tekst && <span>{k.tekst}</span>}
            </li>
          ))
        }
      </ul>
      <dl class="pytania">
        {
          pytania.map((f) => (
            <div>
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </div>
          ))
        }
      </dl>
      <p class="tresc-link">
        <a href={strony.faq.href} class="link-strong">Wszystkie pytania <span aria-hidden="true">→</span></a>
      </p>
    </div>

    <div slot="dostarczone" class="zamow">
      <div class="zamow-panel ramka">
        <Button href={orderLink.href}>{orderLink.label}</Button>
        <p class="miekki">albo zadzwoń</p>
        <a href={firma.phone.href} class="telefon">
          <span class="sr-only">Zadzwoń: </span>{firma.phone.label}
        </a>
      </div>
      <div class="zamow-panel magazyn">
        <h3>Magazyn i odbiór osobisty</h3>
        <address>{addressLine()}</address>
        <dl class="godziny">
          {
            firma.hours.map((h) => (
              <div>
                <dt>{h.label}</dt>
                <dd>{hoursRange(h)}</dd>
              </div>
            ))
          }
        </dl>
        <p class="miekki">{firma.closedNote} Odbiór osobisty po wcześniejszym telefonie.</p>
        <p class="tresc-link">
          <a href={strony.kontakt.href} class="link-strong">Kontakt i formularz <span aria-hidden="true">→</span></a>
        </p>
      </div>
    </div>
  </Droga>
</Base>

<style>
  /* The sign at poster size: PELLET as wide as the column, the town under
     it spaced out to the same width, as on the banner. The capitals are a
     style; the heading reads "Pellet Bieżuń". */
  .hero {
    padding-top: clamp(0.75rem, 2.5svh, 2rem);
    padding-bottom: 1rem;
    overflow-x: clip;
  }
  .wordmark {
    --wm: min(27vw, 30svh, 17rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-transform: uppercase;
    font-weight: 900;
    line-height: 0.8;
    letter-spacing: -0.045em;
    /* One word a line; a reader's wider letter spacing may still break a
       word rather than push it out of the page. */
    overflow-wrap: anywhere;
  }
  .wordmark-pellet {
    font-size: var(--wm);
    margin-left: -0.04em;
  }
  /* Set like the sign: heavy, normal tracking, sized to end under the T. */
  .wordmark-miasto {
    margin-top: 0.2em;
    margin-left: -0.03em;
    font-size: calc(var(--wm) * 0.915);
    letter-spacing: -0.02em;
  }
  /* The sticker is stuck over a corner of the sign, as on a shop window:
     on phones over the end of BIEŻUŃ, hanging below the sign; on wide
     screens over the end of the T. It covers only the corners of the
     letters. */
  .hero-znak {
    position: relative;
    width: fit-content;
  }
  .hero .naklejka {
    position: absolute;
    right: 0;
    bottom: 0;
    margin: 0;
    transform: translate(12%, 62%) rotate(-3deg);
    box-shadow: 0 0 0 0.25rem var(--color-white);
  }
  .hero-dol {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 3.4rem;
  }
  .hero-akcje {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  /* Phones and other upright windows. Over the phone's drive (droga.css,
     where `--scena-h` is set) the first screen holds the hero and the
     drive's whole scene under it: the wordmark, 1.715 times its font size
     tall, gives way as far as that needs, down to a floor on the lowest
     windows. `--reszta` is the rest of the hero by its sizes here: the
     paddings, the sticker's part below the sign, the row of actions, and a
     strip of white under the scene's road. Without the drive the wordmark keeps its own size:
     `--wm-ekran` is then invalid, and the fallback is taken. */
  @media (width < 56rem), (aspect-ratio < 1) {
    .hero {
      --reszta: 8.4rem;
      --wm-ekran: calc((100svh - var(--header-height) - var(--scena-h) - var(--reszta)) / 1.715);
      padding-bottom: 0.75rem;
    }
    .wordmark {
      --wm: max(3.5rem, min(27vw, 30svh, 17rem, var(--wm-ekran, 17rem)));
    }
    .hero-dol {
      gap: 0.9rem;
    }
    /* The order button and the phone side by side, sized to fit a 360 px
       phone; a narrower one has them one under the other. */
    .hero-akcje {
      flex-wrap: nowrap;
      gap: 0.75rem;
    }
    .hero :global(.btn) {
      padding-inline: min(1.6rem, 6vw);
    }
    .hero .telefon {
      font-size: clamp(1.1rem, 5.6vw, 1.5rem);
    }
  }
  @media (width < 22.5rem) {
    .hero {
      --reszta: 11.6rem;
    }
    .hero-akcje {
      flex-wrap: wrap;
    }
  }
  /* Wide landscape windows: the two actions beside the
     wordmark, at its foot. The wordmark leaves them at least 17rem: PELLET
     is about 3.2 times its font size wide. Should they still not fit (a
     reader's own wider letter spacing), they go under it. An upright window
     keeps the phone's layout, which suits its height. */
  @media (min-width: 56rem) and (min-aspect-ratio: 1 / 1) {
    .hero {
      --odstep: clamp(2rem, 5vw, 4.5rem);
      container-type: inline-size;
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      gap: 1.25rem var(--odstep);
    }
    .wordmark {
      --wm: min(30svh, 17rem, (100cqi - 17rem - var(--odstep)) / 3.2);
    }
    .hero-znak {
      flex: none;
    }
    .hero .naklejka {
      top: 0;
      bottom: auto;
      transform: translate(78%, -4%) rotate(-10deg);
    }
    .hero-dol {
      flex: 1 0 17rem;
      max-width: 24rem;
      margin-top: 0;
      padding-bottom: 0.3rem;
    }
  }

  /* The phone written like on the truck: big, heavy, black. */
  .telefon {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    /* A finger's target, 44 px, though the text is shorter. */
    min-height: 2.45rem;
    color: var(--color-black);
    font-size: clamp(1.3rem, 5vw, 1.5rem);
    font-weight: 900;
    letter-spacing: -0.01em;
    text-decoration-line: underline;
    text-decoration-color: var(--color-yellow);
    text-decoration-thickness: 0.2rem;
    text-underline-offset: 0.2em;
  }
  .telefon:hover {
    color: var(--color-black);
    text-decoration-thickness: 0.3rem;
  }
  .telefon svg {
    width: 1.1em;
    height: 1.1em;
  }

  /* A shop-window sticker, after the red "DOSTAWA GRATIS!" disc on the
     printer's banner: a tilted tag on phones, a disc on wide screens. The
     products' disc stands in a column of its own at the frame's right end,
     poking over its corner; the hero's stands over the actions, once the
     hero sets them beside the wordmark. */
  .naklejka {
    display: inline-flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-bottom: 1.25rem;
    padding: 0.7rem 1.1rem;
    background: var(--color-red);
    color: var(--color-white);
    border-radius: 0.75rem;
    transform: rotate(-3deg);
    line-height: 1.1;
    text-align: center;
  }
  .naklejka span {
    font-size: 0.95rem;
    font-weight: 700;
  }
  .naklejka strong {
    font-size: 1.3rem;
    font-weight: 900;
    text-transform: uppercase;
  }
  /* Under the products' rows, never over one. */
  .produkty .naklejka {
    margin: 1.25rem 0 0;
  }
  @media (min-width: 56rem) and (min-aspect-ratio: 1 / 1) {
    .hero .naklejka {
      justify-content: center;
      width: 11rem;
      aspect-ratio: 1;
      padding: 1rem;
      border-radius: 50%;
      box-shadow: 0 0 0 0.3rem var(--color-white);
    }
    /* One line, not the offer's two: set larger to fill the disc as much. */
    .hero .naklejka span {
      font-size: 1.05rem;
    }
    .hero .naklejka strong {
      font-size: 1.7rem;
    }
  }

  /* ---- The drive's stops (Droga.astro): what each one says -------------- */

  /* Set at the drive's size: smaller than a page's sections, as each stop
     shares the screen with the scene. The wide version's media query is
     the live drive's (droga.css), so the products stand as cards and the
     tiles in a row there; elsewhere one column. */
  .miekki {
    color: var(--color-ink-soft);
  }
  .tresc-link {
    margin-top: 0.9rem;
  }
  :is(.produkt, .magazyn) h3,
  .pytania dt {
    font-family: var(--font-display);
    font-weight: 800;
    line-height: 1.15;
  }

  /* The products in the yellow frame (`.ramka`), with the sticker. The bag
     beside the text, one under another on a phone, side by side on a wide
     screen. */
  .produkty {
    padding: 1.25rem 1.1rem;
  }
  @media (min-width: 40rem) {
    .produkty {
      padding: 1.5rem 1.75rem;
    }
  }
  .produkty-lista {
    display: grid;
    gap: 1.1rem;
  }
  /* On a phone the bag stays small enough to leave the price its one line
     from 360 px; narrower, it breaks before the "/". */
  .produkt {
    display: grid;
    grid-template-columns: 3.75rem minmax(0, 1fr);
    align-items: center;
    gap: 0.8rem;
  }
  .produkt + .produkt {
    padding-top: 1.1rem;
    border-top: 2px solid var(--color-yellow);
  }
  .produkt-opis {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
    font-size: 0.9rem;
  }
  .produkt h3 {
    font-size: 1.15rem;
  }
  .produkt-cena {
    margin-block: 0.2rem;
    padding-inline: 0.9rem;
    font-size: 1.05rem;
  }
  /* Packshots are shot on white; multiply lets that white vanish into the
     frame, so only the bag and its shadow show. */
  .produkt-foto {
    width: 3.75rem;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  @media (min-width: 64rem) and (orientation: landscape) {
    .produkty-lista {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
    /* Three cards a row leave each about 11rem for the text from 64rem:
       a smaller bag and a narrower tag keep the price on one line. */
    .produkt {
      grid-template-columns: 3.5rem minmax(0, 1fr);
      align-items: start;
      gap: 0.75rem;
    }
    .produkt + .produkt {
      padding-top: 0;
      border-top: 0;
    }
    .produkt-foto {
      width: 3.5rem;
    }
    .produkt-cena {
      padding-inline: 0.9rem;
      font-size: 1rem;
    }
  }
  @media (min-width: 80rem) and (orientation: landscape) {
    .produkt {
      grid-template-columns: 4rem minmax(0, 1fr);
      gap: 1rem;
    }
    .produkt-foto {
      width: 4rem;
    }
    .produkt-cena {
      font-size: 1.1rem;
    }
  }
  /* Where the three cards still fit beside it, the sticker is a disc in its
     own column at the frame's right end, so it covers no card; it pokes out
     over the frame's corner, as if stuck on it. Narrower, it stays the tag
     under the cards. */
  @media (min-width: 80rem) and (orientation: landscape) {
    .produkty {
      display: flex;
      align-items: flex-start;
      gap: 1.5rem;
    }
    .produkty-lista {
      flex: 1;
    }
    .produkty .naklejka {
      flex: none;
      justify-content: center;
      width: 11rem;
      aspect-ratio: 1;
      margin: -3.25rem -2.75rem 0 0;
      padding: 1rem;
      border-radius: 50%;
      transform: rotate(-10deg);
      box-shadow: 0 0 0 0.3rem var(--color-white);
    }
    .produkty .naklejka strong {
      font-size: 1.35rem;
    }
  }
  /* Without the drive's motion each stop has its still frame right above
     the frame: there the disc does not poke out over it. */
  @media (min-width: 80rem) and (orientation: landscape) and (prefers-reduced-motion: reduce) {
    .produkty .naklejka {
      margin-top: 0;
    }
  }
  @media (min-width: 80rem) and (orientation: landscape) {
    :global(html:not([data-js])) .produkty .naklejka {
      margin-top: 0;
    }
  }

  /* The fleet: each vehicle on its own strip of road, all to one scale (the
     longest the strip's full width) and nose to the left, as on the offer
     page. On a wide screen the strip is narrower, its text beside it, two
     a row, so the four fit above the scene. */
  .flota-lista {
    display: grid;
    gap: 0.75rem;
  }
  .flota-auto {
    display: grid;
    gap: 0.3rem;
  }
  /* Make and model as the label, the details smaller and softer. */
  .flota-opis {
    font-size: 0.85rem;
    line-height: 1.3;
  }
  .flota-model {
    font-size: 1rem;
    font-weight: 700;
  }
  .flota-pas {
    display: block;
    padding-bottom: 0.45rem;
    background:
      linear-gradient(90deg, var(--color-white) 0 50%, transparent 50%) 0 calc(100% - 0.17rem) / 1.4rem 0.1rem repeat-x,
      linear-gradient(var(--color-asphalt), var(--color-asphalt)) 0 100% / 100% 0.45rem no-repeat;
  }
  .flota-foto {
    display: block;
    margin-left: 0.3rem;
    /* Tyres touch the asphalt. */
    margin-bottom: -0.2rem;
  }
  .flota-foto :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (min-width: 64rem) and (orientation: landscape) {
    .flota-lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem 2.5rem;
    }
    .flota-auto {
      grid-template-columns: 18rem minmax(0, 1fr);
      align-items: end;
      gap: 1.5rem;
    }
    .flota-opis {
      order: 1;
      padding-bottom: 0.3rem;
    }
  }

  /* The towns' boards: two a row on a phone (global.css); on a wide screen
     as many as fit, the distance under the name. */
  @media (min-width: 64rem) and (orientation: landscape) {
    .miasta .tablice {
      grid-template-columns: repeat(auto-fill, minmax(7.5rem, 1fr));
    }
    .miasta :global(.tablica) {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.1rem;
      padding: 0.75rem 0.95rem 0.65rem;
      font-size: 1.05rem;
      line-height: 1.25;
    }
  }

  /* At the customer's: three tiles, then two questions from the FAQ. */
  .kafelki {
    display: grid;
    gap: 0.75rem;
  }
  .kafelki li {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.9rem 1rem;
    border-top: 0.3rem solid var(--color-yellow);
    background: var(--color-sand);
    font-size: 0.9rem;
    line-height: 1.35;
  }
  .kafelki strong {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 900;
    line-height: 1.1;
  }
  .pytania {
    margin-top: 1rem;
    border-bottom: 2px solid var(--color-line);
  }
  .pytania div {
    padding-block: 0.7rem;
    border-top: 2px solid var(--color-line);
  }
  .pytania dt {
    font-size: 1rem;
  }
  .pytania dd {
    margin-top: 0.2rem;
    color: var(--color-ink-soft);
    font-size: 0.9rem;
    line-height: 1.4;
  }
  @media (min-width: 64rem) and (orientation: landscape) {
    .kafelki {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .pytania {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
