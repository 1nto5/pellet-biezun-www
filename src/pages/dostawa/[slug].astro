---
/**
 * One page per town in `podstrony`: what a buyer from that town needs to
 * know, in sentences a search engine or an AI answer can quote. What makes
 * each page its own is the distance, the zone, the towns around it and the
 * client's own words about the town (`podstrona.opis`).
 */
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import PageShell from "../../components/PageShell.astro";
import PageHeader from "../../components/PageHeader.astro";
import Button from "../../components/Button.astro";
import Mapa from "../../components/Mapa.astro";
import NazwaMiejsca from "../../components/NazwaMiejsca.astro";
import { firma, addressLine } from "../../data/firma";
import { strony } from "../../data/nav";
import {
  DARMOWA_DOSTAWA_KM,
  miejsca,
  podstrony,
  miejsceHref,
  odlegloscKm,
  type MiejsceZPodstrona,
} from "../../data/miejsca";
import { produkty, cenyLabel, paletaLabel, cenyZDnia } from "../../data/oferta";
import { distanceKm } from "../../lib/geo";
import { maPodstrone, pelnaNazwa } from "../../lib/miejsce";

export const getStaticPaths = (() =>
  podstrony.map((miejsce) => ({ params: { slug: miejsce.podstrona.slug }, props: { miejsce } }))) satisfies GetStaticPaths;

interface Props {
  miejsce: MiejsceZPodstrona;
}

/** Towns this close to the page's town are listed as its neighbourhood. */
const OKOLICA_KM = 25;

const { miejsce } = Astro.props;
const { wMiejscowosci: w, doMiejscowosci: doM, opis } = miejsce.podstrona;
const km = odlegloscKm(miejsce);

// Nearest to the warehouse first, as the board shows their distance from it.
const okolica = miejsca
  .filter((m) => m.nazwa !== miejsce.nazwa && distanceKm(miejsce.geo, m.geo) <= OKOLICA_KM)
  .sort((a, b) => odlegloscKm(a) - odlegloscKm(b));

const lead = `Dowozimy pellet ${doM} i okolic. Z naszego magazynu we Władysławowie pod Bieżuniem to ok. ${km} km drogą.`;
---

<Base
  title={`Pellet ${w} z dostawą`}
  description={`Pellet drzewny w workach 15 kg ${doM}: ok. ${km} km od magazynu pod Bieżuniem, dostawa własnymi autami. Ceny, rozładunek windą, odbiór w magazynie.`}
>
  <PageShell>
    <PageHeader slot="header" title={`Pellet ${w}`} lead={lead}>
      <div class="drogowskaz mt-8" role="img" aria-label={`${miejsce.nazwa}: ${km} km od magazynu`}>
        <div>
          <div>
            <span class="drogowskaz-nazwa">{miejsce.nazwa}</span>
            <span class="drogowskaz-km">{km} km</span>
            <span class="drogowskaz-uwaga">od magazynu</span>
          </div>
        </div>
      </div>
    </PageHeader>

    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <div class="prose">
        <h2>Dostawa</h2>
        {opis && <p>{opis}</p>}
        <p>
          Dostawa gratis {DARMOWA_DOSTAWA_KM} km od magazynu, licząc po drogach. Dalej warunki ustalamy
          indywidualnie przez telefon.
        </p>
        <p>
          Dowozimy własnymi samochodami. Iveco i solówki Volvo mają windę, a każde auto elektryczny
          wózek paletowy, więc paletę zdejmujemy z auta i podwozimy na miejsce. Na dojazd w trudno dostępne miejsca mamy mniejsze auta Iveco Daily.
        </p>
        {
          okolica.length > 0 && (
            <p>Inne miejscowości w okolicy, do których dowozimy: {okolica.map(pelnaNazwa).join(", ")}.</p>
          )
        }

        <h2>Ceny</h2>
        <ul>
          {
            produkty.map((p) => (
              <li>
                {p.nazwa}: <strong>{cenyLabel(p).join(", ")}</strong> ({paletaLabel(p)})
              </li>
            ))
          }
        </ul>
        <p>
          Ceny z {cenyZDnia}. Przy większych zamówieniach cena do negocjacji.{" "}
          <a href={strony.oferta.href}>Parametry i certyfikaty pelletu</a> znajdziesz w ofercie.
        </p>

        <h2>Odbiór w magazynie</h2>
        <p>
          Pellet możesz też odebrać osobiście: {addressLine()}. Przed przyjazdem zadzwoń pod{" "}
          <a href={firma.phone.href}>{firma.phone.label}</a>.
        </p>
      </div>
      <div class="space-y-6">
        {
          okolica.length > 0 && (
            <section class="sign okolica" aria-labelledby="okolica" data-ruch="tablica">
              <h2 id="okolica" class="text-lg text-white">W okolicy</h2>
              <ul role="list" class="mt-2">
                {okolica.map((m) => (
                  <li>
                    <span>
                      {maPodstrone(m) ? (
                        <a href={miejsceHref(m)}>
                          <NazwaMiejsca miejsce={m} />
                        </a>
                      ) : (
                        <NazwaMiejsca miejsce={m} />
                      )}
                    </span>
                    <span class="font-extrabold">{odlegloscKm(m)} km</span>
                  </li>
                ))}
              </ul>
              <p class="mt-3 text-sm">Odległość od magazynu po drogach, jak w nawigacji.</p>
            </section>
          )
        }
        <Mapa
          miejsca={[miejsce, ...okolica]}
          wyroznione={miejsce}
          label={`Mapa: magazyn i ${miejsce.nazwa} z okolicą`}
          class="mapa-kwadrat"
        />
      </div>
    </div>

    <div class="mt-12 flex flex-wrap gap-3">
      <Button href={`${strony.zamowienie.href}?miejscowosc=${encodeURIComponent(miejsce.nazwa)}`}>Zamów dostawę {doM}</Button>
      <Button href={strony.mapa.href} variant="secondary">Wszystkie miejscowości</Button>
    </div>
  </PageShell>
</Base>

<style>
  /* The neighbourhood as a small direction board. */
  .okolica {
    padding: 1.1rem 1.3rem 1rem;
  }
  .okolica li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.3rem 0 0.2rem;
    border-top: 1px solid color-mix(in srgb, var(--color-white) 40%, transparent);
    font-weight: 700;
  }
  /* White on the board, like the rest of its text: a link's own green
     would vanish into it. */
  .okolica a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }
  .okolica a:hover {
    color: inherit;
    text-decoration-thickness: 2px;
  }
</style>
