---
/**
 * One page per town in `podstrony`: what a buyer from that town needs to
 * know, in sentences a search engine or an AI answer can quote. What makes
 * each page its own is the town's name and county, its distance by road, the
 * towns on the way and around it, and the client's own words about the town
 * (`podstrona.opis`).
 */
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import PageShell from "../../components/PageShell.astro";
import PageHeader from "../../components/PageHeader.astro";
import Button from "../../components/Button.astro";
import Mapa from "../../components/Mapa.astro";
import NazwaMiejsca from "../../components/NazwaMiejsca.astro";
import { firma, firmaId, addressLine } from "../../data/firma";
import { strony } from "../../data/nav";
import {
  ZASADA_DOSTAWY,
  miejsca,
  podstrony,
  miejsceHref,
  odlegloscKm,
  poDrodze,
  type MiejsceZPodstrona,
} from "../../data/miejsca";
import { produkty, produktHref, cenyLabel, paletaLabel, cenyZDnia } from "../../data/oferta";
import { distanceKm } from "../../lib/geo";
import { maPodstrone, nazwaWlasna, pelnaNazwa } from "../../lib/miejsce";
import { absoluteUrl } from "../../lib/url";

export const getStaticPaths = (() =>
  podstrony.map((miejsce) => ({ params: { slug: miejsce.podstrona.slug }, props: { miejsce } }))) satisfies GetStaticPaths;

interface Props {
  miejsce: MiejsceZPodstrona;
}

/** Towns this close to the page's town are listed as its neighbourhood. */
const OKOLICA_KM = 25;

const { miejsce } = Astro.props;
const { slug, wMiejscowosci: w, doMiejscowosci: doM, wPowiecie, opis } = miejsce.podstrona;
const km = odlegloscKm(miejsce);
// "Mławę, Nidzicę" would need another case, so the towns stay in the
// nominative: "Po drodze jest Drobin", "Po drodze są Mława i Nidzica".
const mijane = poDrodze(miejsce).map(nazwaWlasna);
const poDrodzeZdanie =
  mijane.length > 0 &&
  ` Po drodze ${mijane.length === 1 ? "jest" : "są"} ${new Intl.ListFormat("pl", { type: "conjunction" }).format(mijane)}, tam też dowozimy.`;

// Nearest to the warehouse first.
const okolica = miejsca
  .filter((m) => m.nazwa !== miejsce.nazwa && distanceKm(miejsce.geo, m.geo) <= OKOLICA_KM)
  .sort((a, b) => odlegloscKm(a) - odlegloscKm(b));

const lead = `Dowozimy pellet ${doM} i okolic.`;

// The delivery to this town as a service of the company (Base.astro), so the
// town is named in the structured data too, as on the page.
const usluga = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: `Dostawa pelletu ${doM}`,
  serviceType: "Dostawa pelletu drzewnego",
  url: absoluteUrl(`/dostawa/${slug}/`),
  provider: { "@id": firmaId },
  areaServed: {
    "@type": "City",
    name: nazwaWlasna(miejsce),
    containedInPlace: { "@type": "AdministrativeArea", name: `województwo ${miejsce.wojewodztwo}` },
  },
};
---

<Base
  title={`Pellet ${w} z dostawą`}
  description={`Pellet drzewny w workach 15 kg ${doM}, ${km} km od magazynu pod Bieżuniem. Dostawa gratis własnymi autami, rozładunek windą. Ceny i odbiór w magazynie.`}
  jsonLd={[usluga]}
>
  <PageShell>
    <PageHeader slot="header" title={`Pellet ${w}`} lead={lead}>
      <div class="drogowskaz mt-8" role="img" aria-label={miejsce.nazwa}>
        <div>
          <div>
            <span class="drogowskaz-nazwa">{miejsce.nazwa}</span>
          </div>
        </div>
      </div>
    </PageHeader>

    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <div class="prose">
        <h2>Dostawa {doM}</h2>
        <p>
          {miejsce.nazwa} leży {km} km od naszego magazynu we Władysławowie pod Bieżuniem. Dowozimy {doM} i do miejscowości {wPowiecie}.
          {poDrodzeZdanie}
        </p>
        {opis && <p>{opis}</p>}
        <p>
          {ZASADA_DOSTAWY} Dowozimy własnymi samochodami. Każde auto ma windę i elektryczny wózek paletowy, paletę zdejmujemy z auta i podwozimy na miejsce. Na dojazd w trudno dostępne miejsca mamy mniejsze auta Iveco Daily.
        </p>
        {
          okolica.length > 0 && (
            <p>Inne miejscowości w okolicy, do których dowozimy: {okolica.map(pelnaNazwa).join(", ")}.</p>
          )
        }

        <h2>Ceny</h2>
        <ul>
          {
            produkty.map((p) => (
              <li>
                <a href={produktHref(p)}>{p.nazwa}</a>: <strong>{cenyLabel(p).join(", ")}</strong> ({paletaLabel(p)})
              </li>
            ))
          }
        </ul>
        <p>
          Ceny z {cenyZDnia}. Przy większym zamówieniu cena do negocjacji.
          Parametry i certyfikat każdego pelletu są na jego stronie.
        </p>

        <h2>Odbiór w magazynie</h2>
        <p>
          Pellet możesz też odebrać osobiście: {addressLine()}. Przed przyjazdem zadzwoń pod{" "}
          <a href={firma.phone.href}>{firma.phone.label}</a>.
        </p>
      </div>
      <div class="space-y-6">
        {
          okolica.length > 0 && (
            <section class="sign okolica" aria-labelledby="okolica" data-ruch="tablica">
              <h2 id="okolica" class="text-lg text-white">W okolicy</h2>
              <ul role="list" class="mt-2">
                {okolica.map((m) => (
                  <li>
                    <span>
                      {maPodstrone(m) ? (
                        <a href={miejsceHref(m)}>
                          <NazwaMiejsca miejsce={m} />
                        </a>
                      ) : (
                        <NazwaMiejsca miejsce={m} />
                      )}
                    </span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
        <Mapa
          miejsca={[miejsce, ...okolica]}
          wyroznione={miejsce}
          label={`Mapa: magazyn i ${miejsce.nazwa} z okolicą`}
          class="mapa-kwadrat"
        />
      </div>
    </div>

    <div class="mt-12 flex flex-wrap gap-3">
      <Button href={`${strony.zamowienie.href}?miejscowosc=${encodeURIComponent(miejsce.nazwa)}`}>Zamów dostawę {doM}</Button>
      <Button href={strony.mapa.href} variant="secondary">Wszystkie miejscowości</Button>
    </div>
  </PageShell>
</Base>

<style>
  /* The neighbourhood as a small direction board. */
  .okolica {
    padding: 1.1rem 1.3rem 1rem;
  }
  .okolica li {
    padding: 0.3rem 0 0.2rem;
    border-top: 1px solid color-mix(in srgb, var(--color-white) 40%, transparent);
    font-weight: 700;
  }
  /* White on the board, like the rest of its text: a link's own green
     would vanish into it. */
  .okolica a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }
  .okolica a:hover {
    color: inherit;
    text-decoration-thickness: 2px;
  }
</style>
