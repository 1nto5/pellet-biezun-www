---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import PageShell from "../components/PageShell.astro";
import PageHeader from "../components/PageHeader.astro";
import Button from "../components/Button.astro";
import Pasy from "../components/Pasy.astro";
import Produkt from "../components/Produkt.astro";
import { firma, addressLine } from "../data/firma";
import { orderLink, strony } from "../data/nav";
import { produkty, produktHref, cenyZDnia, opisOferty } from "../data/oferta";
import { ZASADA_DOSTAWY } from "../data/miejsca";
import { flota, udzial, szczegolyLabel } from "../data/flota";

/**
 * What the product's own page adds, for the link to it: "Parametry,
 * certyfikat i badania" with a test report, "Parametry i certyfikat" without.
 */
function zawartoscStrony(p: (typeof produkty)[number]): string {
  const czesci = ["Parametry", ...(p.certyfikat ? ["certyfikat"] : []), ...(p.dokument ? ["badania"] : [])];
  return czesci.length < 2 ? czesci.join("") : `${czesci.slice(0, -1).join(", ")} i ${czesci.at(-1)}`;
}

/** Each vehicle with its width as a share of a full row (`dl`). */
const auta = flota.map((f) => ({ ...f, dl: udzial(f) }));
---

<Base
  title="Wood Pellets IKEA Wielbark i Pellet HITON"
  description={opisOferty()}
>
  <PageShell>
    <PageHeader
      slot="header"
      title="Pellet HITON i Wood Pellets IKEA Wielbark"
      lead="Dwa rodzaje certyfikowanego pelletu drzewnego polskiej produkcji, w workach 15 kg. Palety są zapakowane fabrycznie i przykryte foliowym kapturem, więc mogą stać na zewnątrz."
    />

    {/* Each product in short; its parameters, certificate and photos are on
        its own page. The ids stay: the Google Business Profile links here. */}
    {
      produkty.map((p, i) => (
        <Produkt
          produkt={p}
          pierwszy={i === 0}
          class:list={[i > 0 && "mt-16 border-t-2 border-ink pt-16"]}
          aria-labelledby={`produkt-${p.id}`}
        >
          <h2 slot="nazwa" id={`produkt-${p.id}`} class="produkt-nazwa">
            <a href={produktHref(p)}>{p.nazwa}</a>
          </h2>
          <div class="mt-6">
            <a href={produktHref(p)} class="link-strong">
              {zawartoscStrony(p)}<span class="sr-only">: {p.nazwa}</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </Produkt>
      ))
    }

    <p class="mt-10 text-sm text-ink-soft">
      Ceny z {cenyZDnia}. Przy większym zamówieniu cena do negocjacji.
    </p>

    <section class="mt-20" aria-labelledby="dostawa">
      <Pasy />
      <h2 id="dostawa" class="mt-6 text-3xl md:text-4xl">Dostawa i odbiór</h2>
      <div class="prose mt-5">
        <p>
          {ZASADA_DOSTAWY} Sprawdź swoją miejscowość na
          <a href={strony.mapa.href}>mapie dystrybucji</a>.
        </p>
        <p>Dowozimy własnymi samochodami. Każdy ma windę i elektryczny wózek paletowy:</p>
      </div>

      <ul role="list" id="flota" class="flota mt-6" data-ruch-grupa="auto">
        {
          auta.map((f) => (
            <li class:list={["flota-auto", f.wParze && "flota-w-parze"]} data-ruch-razem={f.wParze}>
              <span class="flota-pas">
                <span class="flota-foto" style={`--dl:${f.dl}`} data-ruch-auto>
                  <Image
                    src={f.zdjecie}
                    alt={f.alt}
                    width={1200}
                    widths={[300, 400, 600, 800, 1200]}
                    sizes={`(min-width: 64rem) calc(${f.dl} * 34rem), calc(${f.dl} * 92vw)`}
                  />
                </span>
              </span>
              <div>
                <p class="font-bold">{f.model}</p>
                <p class="text-sm text-ink-soft">{szczegolyLabel(f)}</p>
                <div class="flota-palety" aria-hidden="true" data-ruch-grupa="paleta">
                  {Array.from({ length: f.max }, (_, k) => (
                    <span class:list={[k >= f.min && "flota-moze"]} />
                  ))}
                </div>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="prose mt-8">
        <p>
          Odbiór osobisty w magazynie: {addressLine()}. Przed przyjazdem zadzwoń pod{" "}
          <a href={firma.phone.href}>{firma.phone.label}</a>.
        </p>
      </div>
    </section>

    <div class="mt-14 flex flex-wrap gap-4">
      <Button href={orderLink.href}>{orderLink.label}</Button>
      <Button href={strony.faq.href} variant="secondary">Częste pytania</Button>
    </div>
  </PageShell>
</Base>

<style>
  .produkt-nazwa {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  /* The name links to the product's page but reads as a heading. */
  .produkt-nazwa a {
    color: inherit;
    text-decoration-thickness: 3px;
  }

  /* The fleet: each truck standing on its own strip of road, all to one
     scale and nose to the left like in the drive on the home page, with its
     row of pallet blocks. A Volvo has a row to itself; the two Iveco stand
     side by side, each on half a row, with its own label under it. */
  .flota {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 0.5rem;
    max-width: 64rem;
  }
  .flota-auto {
    display: grid;
    grid-column: 1 / -1;
    align-content: start;
    gap: 0.75rem;
  }
  .flota-w-parze {
    grid-column: auto;
    /* Half a row is the whole of this cell. */
    --w-rzedzie: 2;
  }
  @media (min-width: 64rem) {
    /* The two halves together are as wide as a Volvo's strip. */
    .flota {
      grid-template-columns: repeat(2, 16.75rem) minmax(0, 1fr);
    }
    .flota-auto:not(.flota-w-parze) {
      grid-template-columns: 34rem minmax(0, 1fr);
      align-items: end;
      gap: 2.5rem;
    }
  }
  /* The road: asphalt with a dashed edge line, the truck's tyres on it. */
  .flota-pas {
    display: block;
    /* The truck drives in from the right edge of its road. */
    overflow-x: clip;
    padding-bottom: 0.55rem;
    background:
      linear-gradient(90deg, var(--color-white) 0 50%, transparent 50%) 0 calc(100% - 0.2rem) / 1.6rem 0.12rem repeat-x,
      linear-gradient(var(--color-asphalt), var(--color-asphalt)) 0 100% / 100% 0.55rem no-repeat;
  }
  /* `--dl` is the vehicle's share of a full row; in a cell that is half a
     row (`--w-rzedzie`) it takes twice that share of the cell. */
  .flota-foto {
    position: relative;
    display: flex;
    align-items: flex-end;
    width: calc(var(--dl) * var(--w-rzedzie, 1) * (100% - 0.4rem));
    margin-left: 0.4rem;
    /* Tyres touch the asphalt. */
    margin-bottom: -0.25rem;
  }
  /* A soft contact shadow under the wheels. */
  .flota-foto::after {
    content: "";
    position: absolute;
    inset: auto 2% 0.1rem 2%;
    height: 0.5rem;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(0 0 0 / 0.35), transparent);
    z-index: -1;
  }
  .flota-foto :global(img) {
    display: block;
    flex: 1 1 0;
    min-width: 0;
    height: auto;
  }
  .flota-palety {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 0.45rem;
  }
  .flota-palety span {
    width: 1.35rem;
    height: 1.1rem;
    border-radius: 0.15rem;
    background: var(--color-asphalt);
    box-shadow: inset 0 -0.25rem 0 var(--color-black);
  }
  .flota-palety .flota-moze {
    background: var(--color-page);
    box-shadow: inset 0 0 0 2px var(--color-asphalt);
  }
</style>
