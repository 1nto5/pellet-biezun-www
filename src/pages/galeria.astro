---
import Base from "../layouts/Base.astro";
import PageShell from "../components/PageShell.astro";
import PageHeader from "../components/PageHeader.astro";
import Gallery from "../components/Gallery.astro";
import { zdjeciaGalerii } from "../data/galeria";
---

<Base
  title="Galeria: samochody, magazyn i pellet"
  description="Zdjęcia naszych samochodów, magazynu we Władysławowie pod Bieżuniem i pelletu, który sprzedajemy."
>
  <PageShell>
    <PageHeader
      slot="header"
      title="Galeria"
      lead="Nasze samochody, magazyn we Władysławowie pod Bieżuniem i pellet, który sprzedajemy. Kliknij zdjęcie, aby je powiększyć."
    />
    <Gallery photos={zdjeciaGalerii} />
  </PageShell>
</Base>
